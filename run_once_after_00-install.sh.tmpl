#!/usr/bin/env bash
# chezmoi runs this once on first apply, and re-runs any time the rendered
# content changes (e.g. you flip a component or update a script). Exports the
# selected components as INSTALL_* env vars, then delegates to install.sh.
set -euo pipefail

export INSTALL_ZSH={{ dig "components" "zsh" true . }}
export INSTALL_TMUX={{ dig "components" "tmux" true . }}
export INSTALL_NEOVIM={{ dig "components" "neovim" true . }}
{{/* Nested sub-feature flags (ai/git/terminal are tables, not bools). Git config, */ -}}
{{- /* ignore_global, and claude_hooks are file-gated, so need no env. terminal       */ -}}
{{- /* CONFIG is file-gated too, but the ghostty/iterm2 BINARY installs use these vars.  */ -}}
{{- /* statusline's FILES are file-gated, but it shells out to jq + python3, so the      */ -}}
{{- /* install.sh package block needs this env var to pull those deps.                   */ -}}
export INSTALL_TERMINAL_GHOSTTY={{ dig "components" "terminal" "ghostty" true . }}
export INSTALL_TERMINAL_ITERM2={{ dig "components" "terminal" "iterm2" false . }}
export INSTALL_AI_CODECOMPANION={{ dig "components" "ai" "codecompanion" false . }}
export INSTALL_AI_STATUSLINE={{ dig "components" "ai" "statusline" false . }}
export INSTALL_NOTIFY={{ or (dig "components" "zsh" true .) (dig "components" "tmux" true .) (dig "components" "ai" "claude_hooks" false .) (dig "components" "ai" "codex_hooks" false .) }}
export DOTFILES_INSTALL_MODE={{ dig "installMode" "packages" . | quote }}

printf 'dotfiles: starting post-apply setup (mode=%s)...\n' "$DOTFILES_INSTALL_MODE"

# Best-effort: initialize the base16 scheme submodule so this machine can
# regenerate the palette catalog (scripts/build-palettes.py). Apply never needs
# it - the committed catalog renders without it - so failures are ignored.
git -C "{{ .chezmoi.sourceDir }}" submodule update --init --depth 1 vendor/tinted-schemes 2>/dev/null || true

bash "{{ .chezmoi.sourceDir }}/scripts/install.sh"
