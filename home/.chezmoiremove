{{/* Files chezmoi should delete from the target on apply. */}}
{{/* notify-lib.sh moved to ~/.config/notify/lib.sh (single-config refactor). */}}
.tmux/notify-lib.sh
{{/* Gud remains the Zsh prompt name, but no longer names color artifacts. */}}
.config/ghostty/themes/gud-theme.conf
.config/statusline/gud-palette.sh
{{/* Chezmoi reads removals before any run_before script, and an lstat of a path
     inside an unsearchable ~/.codex fails the whole apply, so a hook cannot repair
     it first. Stat only ~/.codex itself, which works at any mode, and list the
     old theme when the owner can search it. 64 is the owner execute bit (0o100). */}}
{{ with stat (joinPath .chezmoi.destDir ".codex") -}}
{{ if eq (mod (div .perm 64) 2) 1 -}}
.codex/themes/gud.tmTheme
{{ end -}}
{{ end -}}
{{/* opencode-pillbox-statusline replaced the local OpenCode V2 footer and its
     server plugins. Left behind, the plugin/ files keep auto-loading and serving
     quota RPCs, including the Copilot /models call that pillbox makes opt-in. */}}
.config/opencode/v2-plugins/statusline
.config/opencode/plugin/copilot-tiers.ts
.config/opencode/plugin/codex-quota.ts
.config/opencode/plugin/provider-usage.ts
{{/* A managed package.json and package-lock.json once pinned the OpenCode V2 plugin
     runtime in ~/.config/opencode. sync-runtime.sh now installs it at the CLI's
     version without them, and the stale pins would downgrade a plain npm install
     there. OpenCode also lets users keep their own package.json in that directory,
     so remove only files that still carry the retired package name. */}}
{{ range list "package.json" "package-lock.json" -}}
{{   $path := joinPath $.chezmoi.destDir ".config/opencode" . -}}
{{   if stat $path -}}
{{     if contains "\"dotfiles-opencode-runtime\"" (include $path) -}}
.config/opencode/{{ . }}
{{     end -}}
{{   end -}}
{{ end -}}
