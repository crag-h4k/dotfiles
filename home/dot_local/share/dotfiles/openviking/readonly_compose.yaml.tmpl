name: dotfiles-openviking

services:
{{ if eq .chezmoi.os "linux" }}  ollama:
    image: ollama/ollama:0.40.1
    user: "{{ .chezmoi.uid }}:{{ .chezmoi.gid }}"
    environment:
      HOME: /data
      OLLAMA_HOST: 0.0.0.0:11434
      OLLAMA_MODELS: /data/models
      OLLAMA_KEEP_ALIVE: 1m
      OLLAMA_MAX_LOADED_MODELS: "1"
      OLLAMA_NUM_PARALLEL: "1"
    volumes:
      - ${HOME}/.local/share/ollama:/data
    networks: [models]
    restart: unless-stopped
    healthcheck:
      test: [CMD, ollama, list]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

{{ end }}  openviking:
    image: ghcr.io/volcengine/openviking:v0.4.23
    user: "{{ .chezmoi.uid }}:{{ .chezmoi.gid }}"
    environment:
      HOME: /app
      OPENVIKING_WITH_BOT: "0"
      OPENVIKING_SERVER_HOST: 0.0.0.0
    volumes:
      - ${HOME}/.openviking:/app/.openviking
      - ${HOME}/.config/litellm/github_copilot:/app/.config/litellm/github_copilot
    ports:
      - 127.0.0.1:1933:1933
{{ if eq .chezmoi.os "linux" }}    networks: [models]
    depends_on:
      ollama: {condition: service_healthy}
{{ end }}    restart: unless-stopped
    healthcheck:
      test: [CMD, openviking-entrypoint, --healthcheck]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 90s

{{ if eq .chezmoi.os "linux" }}networks:
  models: {}
{{ end }}
