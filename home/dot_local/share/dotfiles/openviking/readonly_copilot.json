{
  "server": {
    "host": "127.0.0.1",
    "port": 1933,
    "auth_mode": "api_key",
    "root_api_key": "${OPENVIKING_ROOT_API_KEY}"
  },
  "storage": {
    "workspace": "./data",
    "agfs": { "backend": "local" },
    "vectordb": { "backend": "local" }
  },
  "embedding": {
    "max_concurrent": 1,
    "max_input_tokens": 1536,
    "dense": {
      "provider": "litellm",
      "model": "github_copilot/text-embedding-3-small",
      "dimension": 1536
    }
  },
  "vlm": {
    "provider": "litellm",
    "model": "github_copilot/gpt-6-luna",
    "max_concurrent": 1,
    "max_tokens": 4096,
    "max_retries": 1,
    "timeout": 120,
    "extra_request_body": { "reasoning": { "effort": "none" } }
  }
}
