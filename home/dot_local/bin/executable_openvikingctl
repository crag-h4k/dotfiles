#!/usr/bin/env python3
# home/dot_local/bin/executable_openvikingctl
"""Workstation lifecycle commands for the upstream OpenViking server."""
import argparse
import getpass
import importlib.util
import json
import os
from pathlib import Path
import platform
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import urllib.parse

HOME = Path.home()
PRIVATE = HOME / ".openviking"
EXAMPLES = HOME / ".local/share/dotfiles/openviking"
LABEL = "io.github.crag-h4k.dotfiles.openviking"
UNIT = "dotfiles-openviking.service"


def private_json(path):
    stat = path.stat()
    if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
        raise ValueError(f"{path} must be owned by you and have mode 600")
    return json.loads(path.read_text())


def write_private(path, value, replace=False):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not replace:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as handle:
            json.dump(value, handle, indent=2)
            handle.write("\n")
        return
    fd, temporary = tempfile.mkstemp(prefix=".config-", dir=path.parent)
    with os.fdopen(fd, "w") as handle:
        json.dump(value, handle, indent=2)
        handle.write("\n")
    os.replace(temporary, path)


def load_environment():
    path = PRIVATE / "service.env"
    if not path.exists():
        return
    stat = path.stat()
    if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
        raise ValueError("private service.env must be owned by you and have mode 600")
    for line in path.read_text().splitlines():
        parts = shlex.split(line, comments=True)
        if not parts:
            continue
        if parts[0] == "export":
            parts.pop(0)
        if len(parts) != 1 or "=" not in parts[0]:
            raise ValueError("service.env accepts KEY=value assignments, not shell commands")
        key, value = parts[0].split("=", 1)
        if not key.isidentifier():
            raise ValueError("invalid environment variable name in service.env")
        os.environ.setdefault(key, value)


def runtime():
    root = os.environ.get("OPENVIKING_INSTALL_ROOT")
    if not root and (PRIVATE / "runtime.json").exists():
        root = private_json(PRIVATE / "runtime.json")["install_root"]
    return Path(root or HOME / ".local/share/openviking") / "current"


def config_path():
    return Path(os.environ.get("OPENVIKING_CONFIG_FILE", PRIVATE / "ov.conf"))


def server_config():
    config = private_json(config_path())
    server = config.get("server", {})
    if server.get("host", "127.0.0.1") not in ("127.0.0.1", "localhost", "::1"):
        raise ValueError("this workstation service only permits a loopback listener")
    if server.get("auth_mode") != "api_key":
        raise ValueError("configure API-key authentication before starting the service")
    key = server.get("root_api_key", "")
    if not isinstance(key, str) or not key or "${" in key:
        raise ValueError("configure a real private root API key before starting the service")
    port = server.get("port", 1933)
    if type(port) is not int or not 1 <= port <= 65535:
        raise ValueError("server.port must be an integer between 1 and 65535")
    return config


def command(argv, check=True, capture=False):
    return subprocess.run(argv, check=check, capture_output=capture, text=capture)


def init(profile):
    PRIVATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    server = PRIVATE / "ov.conf"
    client = PRIVATE / "ovcli.conf"
    if server.exists():
        print("Preserved existing private ov.conf")
    else:
        config = json.loads((EXAMPLES / (profile + ".json")).read_text())
        config["server"]["root_api_key"] = secrets.token_urlsafe(32)
        write_private(server, config)
        print("Created private ov.conf from the starter profile")
    if client.exists():
        print("Preserved existing private ovcli.conf")
    else:
        write_private(client, json.loads((EXAMPLES / "ovcli.json").read_text()))
        print("Created private ovcli.conf; bootstrap-client will provision its user key")
    print("Edit your private model settings, authenticate, then run openvikingctl doctor")


def compose_file():
    if config_path() != PRIVATE / "ov.conf":
        raise ValueError("Compose mounts ~/.openviking/ov.conf; unset OPENVIKING_CONFIG_FILE before using Compose")
    path = EXAMPLES / "compose.yaml"
    if not path.is_file():
        raise ValueError("managed Compose file is missing; reapply the OpenViking component")
    return path


def compose_args():
    args = ["docker", "compose", "-f", str(compose_file())]
    override = PRIVATE / "compose.override.yaml"
    if override.is_symlink():
        raise ValueError("refusing a symlinked private Compose override")
    if override.exists():
        stat = override.stat()
        if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
            raise ValueError("private Compose override must be owned by you and have mode 600")
        args.extend(["-f", str(override)])
    return args


def compose_ollama_url():
    if platform.system() == "Darwin":
        return "http://host.docker.internal:11434"
    if platform.system() == "Linux":
        return "http://ollama:11434"
    raise ValueError("OpenViking Compose supports macOS and Linux")


def compose_init(profile):
    compose_file()
    created = not config_path().exists()
    init(profile)
    (HOME / ".config/litellm/github_copilot").mkdir(mode=0o700, parents=True, exist_ok=True)
    if created:
        config = server_config()
        changed = False
        for settings in (config.get("embedding", {}).get("dense", {}), config.get("vlm", {})):
            if settings.get("model", "").startswith(("ollama/", "ollama_chat/")):
                settings["api_base"] = compose_ollama_url()
                changed = True
        if changed:
            write_private(config_path(), config, replace=True)
    print("Private model settings are preserved on reruns; confirm their routes before starting Compose")


def compose(action, assume_yes=False):
    args = compose_args()
    if action == "up":
        config = server_config()
        if config.get("server", {}).get("port", 1933) != 1933:
            raise ValueError("Compose publishes port 1933; review the private server.port before starting")
        for name, settings in (("embedding.dense", config.get("embedding", {}).get("dense", {})),
                               ("vlm", config.get("vlm", {}))):
            if settings.get("model", "").startswith(("ollama/", "ollama_chat/")):
                expected = compose_ollama_url()
                if settings.get("api_base", "").rstrip("/") != expected:
                    raise ValueError("private " + name + ".api_base must be " + expected + " for this Compose deployment; review ov.conf before starting")
        command(args + ["config", "--quiet"])
        print("Compose images: ghcr.io/volcengine/openviking:v0.4.23" +
              (", ollama/ollama:0.40.1" if platform.system() == "Linux" else ""))
        if not confirm("Start the selected containers (downloads missing images)?", assume_yes):
            print("Compose start declined")
            return
        if platform.system() == "Linux":
            (HOME / ".local/share/ollama").mkdir(parents=True, exist_ok=True)
        (HOME / ".config/litellm/github_copilot").mkdir(mode=0o700, parents=True, exist_ok=True)
        command(args + ["up", "-d", "--wait"])
    elif action == "stop":
        command(args + ["stop"])
    elif action == "status":
        command(args + ["ps"])


def runtime_command(action):
    helper = EXAMPLES / "runtime.py"
    if not helper.is_file():
        raise ValueError("managed OpenViking runtime helper is missing; reapply the component")
    return [str(runtime() / "bin/python"), str(helper), action, str(config_path())]


def configure_opencode():
    path = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "opencode/opencode.jsonc"
    alternate = path.with_suffix(".json")
    if path.exists() and alternate.exists():
        raise ValueError("both global OpenCode config files exist; consolidate them before configuring MCP")
    if alternate.exists() and not path.exists():
        path = alternate
    if path.is_symlink():
        raise ValueError("review the symlinked global OpenCode config before adding MCP")
    spec = importlib.util.spec_from_file_location("openviking_opencode_config", EXAMPLES / "opencode_config.py")
    helper = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(helper)
    original = path.read_text() if path.exists() else ""
    updated = helper.merge(original, mcp_config()["mcp"]["servers"]["openviking"])
    if updated == original:
        print("Preserved the existing authenticated OpenViking MCP entry")
        return
    if path.exists():
        backup = PRIVATE / "backups" / ("opencode-" + str(time.time_ns()) + path.suffix)
        backup.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        backup.write_bytes(path.read_bytes())
        backup.chmod(0o600)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".openviking-", dir=path.parent)
    with os.fdopen(fd, "w") as stream:
        stream.write(updated)
    os.replace(temporary, path)
    print("Added the private native MCP entry; unrelated settings and comments preserved")


def confirm(message, assume_yes=False):
    return assume_yes or input(message + " [y/N] ").strip().lower() in ("y", "yes")


def opencode_binary():
    found = shutil.which("opencode2")
    if found:
        return found
    wrapper = HOME / ".local/bin/opencode2"
    return str(wrapper) if os.access(wrapper, os.X_OK) else None


def prepare_provider_keys(config, assume_yes):
    changed = False
    for settings in (config.get("vlm", {}), config.get("embedding", {}).get("dense", {})):
        key = settings.get("api_key") or ""
        if not key.startswith("${") or not key.endswith("}"):
            continue
        name = key[2:-1]
        value = os.environ.get(name)
        if not value:
            if assume_yes:
                raise ValueError("missing " + name + "; set it or configure a private model key first")
            value = getpass.getpass(name + " (stored in private ov.conf, never printed): ").strip()
        if not value:
            raise ValueError("model API key was not supplied")
        settings["api_key"] = value
        changed = True
    if changed:
        write_private(config_path(), config, replace=True)


def prepare_ollama(config, models, assume_yes):
    selected = [model.split("/", 1)[1] for model in dict.fromkeys(models)
                if model.startswith(("ollama/", "ollama_chat/"))]
    if not selected:
        return
    if not shutil.which("ollama"):
        raise ValueError("this profile requires native Ollama; install/start it, or use copilot on a fresh workspace")
    settings = config.get("embedding", {}).get("dense", {})
    base = settings.get("api_base", "http://127.0.0.1:11434").rstrip("/")
    parsed = urllib.parse.urlparse(base)
    if parsed.scheme != "http" or parsed.hostname not in ("127.0.0.1", "localhost", "::1") or parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise ValueError("guided Ollama downloads require a loopback HTTP endpoint; provision remote models separately")
    os.environ["OLLAMA_HOST"] = base
    with urllib.request.build_opener(NoRedirect()).open(base + "/api/tags", timeout=10) as response:
        installed = {item["name"] for item in json.load(response)["models"]}
    for name in selected:
        if name in installed or name + ":latest" in installed:
            print("Ollama model already present:", name)
        elif confirm("Download selected Ollama model " + name + "?", assume_yes):
            command(["ollama", "pull", name])
        else:
            raise ValueError("selected Ollama model is missing; setup stopped before starting the service")


def setup(profile, assume_yes=False):
    if not assume_yes and not sys.stdin.isatty():
        raise ValueError("setup needs a terminal; use --yes only after reviewing the profile and provider access")
    print("OpenViking setup: private configuration, model probe, loopback user service, and native MCP.")
    print("Remote providers receive extraction/embedding content. New clients start with capture disabled.")
    print("Existing model, embedding, and capture choices are preserved unless you approve a change.")
    if not confirm("Continue with starter profile " + profile + "?", assume_yes):
        print("Setup declined; no configuration or service changes")
        return
    if not (runtime() / "bin/python").is_file():
        raise ValueError("select ai > openviking and approve its package installation first")
    init(profile)
    config = server_config()
    prepare_provider_keys(config, assume_yes)
    client_path = PRIVATE / "ovcli.conf"
    models = [config.get("vlm", {}).get("model", ""), config.get("embedding", {}).get("dense", {}).get("model", "")]
    print("Extraction model:", models[0])
    print("Embedding model:", models[1])
    if any(model.startswith("github_copilot/") for model in models):
        print("Complete Copilot's separate device login in this terminal.")
        command([str(runtime() / "bin/python"), "-c", "from litellm.llms.github_copilot.authenticator import Authenticator; Authenticator().get_access_token()"])
    prepare_ollama(config, models, assume_yes)
    print("Probe: verifying the selected embedding dimension and extraction response")
    command(runtime_command("probe"))
    service("enable")
    deadline = time.monotonic() + 45
    url = "http://127.0.0.1:" + str(config["server"].get("port", 1933))
    while time.monotonic() < deadline:
        try:
            with urllib.request.build_opener(NoRedirect()).open(url + "/ready", timeout=2) as response:
                if response.status == 200:
                    break
        except OSError:
            pass
        time.sleep(0.5)
    else:
        raise ValueError("user service did not become ready; capture setting was not changed")
    bootstrap_client()
    verify_client()
    opencode = opencode_binary()
    if not opencode:
        print("OpenViking service verified. Select ai > opencode to add this workstation's OpenCode integration.")
        return
    configure_opencode()
    print("Reloading this OpenCode location cancels its pending permission/question forms.")
    if not confirm("Reload this location and verify hooks, native MCP, and skills now?", assume_yes):
        print("Reload/reopen OpenCode, then run openvikingctl check-opencode. Capture setting was not changed.")
        return
    command([opencode, "api", "post", "/api/location/reload"])
    check_opencode()
    client = private_json(client_path)
    if not client.setdefault("plugin", {}).get("autoCapture", True):
        if confirm("Enable automatic capture (including tool output) and reload this location?", assume_yes):
            client["plugin"]["autoCapture"] = True
            write_private(client_path, client, replace=True)
            command([opencode, "api", "post", "/api/location/reload"])
        else:
            print("Capture remains disabled; recall and native MCP are available.")
    print("Registration verified. Test synthetic cross-session recall before capturing ordinary work.")


def service(action):
    if action in ("enable", "restart"):
        server_config()
        if not (runtime() / "bin/openviking-server").is_file():
            raise ValueError("install the OpenViking runtime before enabling its service")
    if platform.system() == "Darwin":
        domain = "gui/" + str(os.getuid())
        if action == "enable":
            target = domain + "/" + LABEL
            command(["launchctl", "enable", target])
            if command(["launchctl", "print", target], check=False, capture=True).returncode == 0:
                command(["launchctl", "kickstart", target])
            else:
                command(["launchctl", "bootstrap", domain, str(HOME / "Library/LaunchAgents" / (LABEL + ".plist"))])
        elif action == "restart":
            command(["launchctl", "kickstart", "-k", domain + "/" + LABEL])
        elif action == "stop":
            command(["launchctl", "disable", domain + "/" + LABEL])
            command(["launchctl", "bootout", domain + "/" + LABEL])
        else:
            command(["launchctl", "print", domain + "/" + LABEL])
    elif platform.system() == "Linux":
        if action == "enable":
            command(["systemctl", "--user", "daemon-reload"])
            command(["systemctl", "--user", "enable", "--now", UNIT])
        elif action == "stop":
            command(["systemctl", "--user", "disable", "--now", UNIT])
        else:
            command(["systemctl", "--user", action, UNIT])
    else:
        raise ValueError("OpenViking user-service wiring supports macOS and Linux")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, msg, headers, new_url):
        return None


def bootstrap_client():
    config = server_config()
    path = PRIVATE / "ovcli.conf"
    client = private_json(path)
    if client.get("api_key"):
        print("Preserved existing client API key")
        return
    port = config["server"].get("port", 1933)
    url = "http://127.0.0.1:" + str(port)
    opener = urllib.request.build_opener(NoRedirect())

    def post(route, body):
        request = urllib.request.Request(url + route, data=json.dumps(body).encode(), headers={
            "Content-Type": "application/json",
            "Authorization": "Bearer " + config["server"]["root_api_key"],
        })
        with opener.open(request, timeout=30) as response:
            return json.load(response)["result"]

    # ROOT administers identities; the agent gets its own USER data credential.
    try:
        post("/api/v1/admin/accounts", {"account_id": "local", "admin_user_id": "operator"})
    except urllib.error.HTTPError as error:
        if error.code != 409:
            raise
    result = post("/api/v1/admin/accounts/local/users", {"user_id": "agent", "role": "user"})
    client["url"] = url
    client["api_key"] = result["user_key"]
    write_private(path, client, replace=True)
    print("Provisioned private USER credential for the agent; no key printed")


def mcp_config():
    client = private_json(PRIVATE / "ovcli.conf")
    settings = client.get("plugin", {})
    if settings.get("opencode", {}).get("mcpEnabled", settings.get("mcpEnabled", True)) is not False:
        raise ValueError("set plugin.opencode.mcpEnabled=false in your private client config first")
    key = client.get("api_key")
    if not isinstance(key, str) or not key:
        raise ValueError("bootstrap the private USER client credential first")
    url = client["url"].rstrip("/")
    parsed = urllib.parse.urlparse(url)
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise ValueError("client URL must not carry credentials or query parameters")
    if parsed.scheme != "https" and not (parsed.scheme == "http" and parsed.hostname in ("127.0.0.1", "localhost", "::1")):
        raise ValueError("native MCP requires loopback HTTP or HTTPS")
    target = PRIVATE / "mcp-user-key"
    if target.is_symlink():
        raise ValueError("refusing to replace a symlinked MCP key file")
    if target.exists():
        stat = target.stat()
        if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
            raise ValueError("existing MCP key file must be private and owned by you")
    fd, temporary = tempfile.mkstemp(prefix=".mcp-key-", dir=PRIVATE)
    with os.fdopen(fd, "w") as handle:
        handle.write(key + "\n")
    os.replace(temporary, target)
    return {"mcp": {"servers": {"openviking": {
        "type": "remote", "url": url + "/mcp", "oauth": False, "codemode": False,
        "headers": {"Authorization": "Bearer {file:" + str(target) + "}"},
    }}}}


def verify_client():
    client = private_json(PRIVATE / "ovcli.conf")
    if not client.get("api_key") or client["api_key"] == server_config()["server"]["root_api_key"]:
        raise ValueError("agent access requires a separate USER credential, not the ROOT key")
    url = client["url"].rstrip("/")
    port = server_config()["server"].get("port", 1933)
    if url != "http://127.0.0.1:" + str(port):
        raise ValueError("guided setup client URL must match this host's loopback service")
    request = urllib.request.Request(url + "/api/v1/fs/ls?uri=viking%3A%2F%2F", headers={
        "Authorization": "Bearer " + client["api_key"],
    })
    with urllib.request.build_opener(NoRedirect()).open(request, timeout=30) as response:
        if json.load(response).get("status") != "ok":
            raise ValueError("authenticated client verification failed")
    print("Authenticated client access verified; private directory contents were not printed")


def check_opencode():
    binary = opencode_binary() or "opencode2"

    def read(route):
        # File stdout avoids losing buffered CLI output for large registries.
        with tempfile.TemporaryFile(mode="w+", dir=PRIVATE) as output:
            subprocess.run([binary, "api", "get", route], check=True,
                           stdout=output, stderr=subprocess.PIPE, text=True, timeout=60)
            output.seek(0)
            return json.load(output)["data"]

    plugins = read("/api/plugin")
    servers = read("/api/mcp")
    skills = read("/api/skill")
    package = "@openviking/opencode-plugin"
    plugin_active = any(
        item.get("source", {}).get("type") == "package" and
        (item["source"].get("target") == package or
         item["source"].get("target", "").startswith(package + "@")) and
        item.get("state", {}).get("status") == "active" for item in plugins)
    mcp_connected = any(item.get("name") == "openviking" and
                        item.get("status", {}).get("status") == "connected" for item in servers)
    required = {"openviking-memory", "openviking-skills", "ov-experience-memory"}
    missing = required - {item["id"] for item in skills}
    print(json.dumps({"plugin_active": plugin_active, "mcp_connected": mcp_connected,
                      "missing_skills": sorted(missing)}))
    if not plugin_active or not mcp_connected or missing:
        raise ValueError("OpenViking registration check failed; do not treat capture/recall as working")


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("setup", "init", "run", "doctor", "probe-models", "mcp-config", "configure-opencode", "check-opencode", "auth-copilot", "bootstrap-client", "enable", "restart", "stop", "status", "version", "cli", "compose-init", "compose-up", "compose-stop", "compose-status"))
    parser.add_argument("--profile", choices=("copilot", "copilot-ollama", "ollama", "openai", "codex-ollama"), default="copilot")
    parser.add_argument("--yes", action="store_true", help="approve reviewed setup steps; does not replace provider login")
    args, remaining = parser.parse_known_args()
    if remaining and args.action != "cli":
        parser.error("extra arguments are only accepted by the cli command")
    if args.action != "check-opencode":
        load_environment()
    bin_dir = runtime() / "bin"
    if args.action == "setup":
        setup(args.profile, args.yes)
    elif args.action == "init":
        init(args.profile)
    elif args.action == "compose-init":
        compose_init(args.profile)
    elif args.action.startswith("compose-"):
        compose(args.action.removeprefix("compose-"), args.yes)
    elif args.action == "auth-copilot":
        command([str(bin_dir / "python"), "-c", "from litellm.llms.github_copilot.authenticator import Authenticator; Authenticator().get_access_token()"])
    elif args.action == "version":
        command([str(bin_dir / "python"), "-c", "import importlib.metadata; print(importlib.metadata.version('openviking'))"])
    elif args.action == "cli":
        command([str(bin_dir / "ov"), *(remaining[1:] if remaining[:1] == ["--"] else remaining)])
    elif args.action == "bootstrap-client":
        bootstrap_client()
    elif args.action == "mcp-config":
        print(json.dumps(mcp_config(), indent=2))
    elif args.action == "configure-opencode":
        configure_opencode()
    elif args.action == "check-opencode":
        check_opencode()
    elif args.action == "doctor":
        server_config()
        command([str(bin_dir / "openviking-server"), "doctor", "--config", str(config_path())])
    elif args.action == "probe-models":
        server_config()
        command(runtime_command("probe"))
    elif args.action == "run":
        config = server_config()
        os.chdir(config_path().parent)
        os.umask(0o077)
        argv = runtime_command("run")
        os.execv(argv[0], argv)
    else:
        service(args.action)


if __name__ == "__main__":
    try:
        main()
    except urllib.error.HTTPError as error:
        print(f"OpenViking HTTP {error.code}; inspect the private server log or existing account state", file=sys.stderr)
        raise SystemExit(1)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print("openvikingctl: " + str(error), file=sys.stderr)
        raise SystemExit(1)
