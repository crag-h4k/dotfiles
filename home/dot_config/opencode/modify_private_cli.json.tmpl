#!/usr/bin/env python3
# home/dot_config/opencode/modify_private_cli.json.tmpl
# chezmoi modify_ script for ~/.config/opencode/cli.json (OpenCode V2 terminal
# client settings). chezmoi runs it with the current file on stdin and writes
# what it prints to stdout. Merge-only and idempotent across `chezmoi apply`.
#
# Why a merge: V2's Open settings dialog writes this same file. A plain managed
# file makes the next `chezmoi init --apply` warn that the target changed since
# chezmoi last wrote it. A merge keeps whatever the TUI wrote.
#
# Ownership boundary:
#   OWNED  - re-asserted on every apply, so the TUI cannot silently turn off a
#            dotfiles integration:
#              "$schema"; attention.notifications / attention.sound = false
#              (OpenCode's own OS banners and sounds; the tmux notifier in
#              plugin/notify.ts is the single attention channel: visual,
#              tmux-only, never popups); keybinds.leader and leader.timeout
#              (the leader stays on OpenCode's default Ctrl+X, which leaves
#              Ctrl+G, OpenCode's default for the first message, to Home);
#              the tab navigation keys (every direction key moves between
#              tabs, so the four pane-focus and terminal defaults that sit on
#              <leader> plus an arrow, and terminal.toggle on <leader>t, are
#              released; the first message also answers to <leader>f for
#              keyboards without a Home key); and the managed "plugins"
#              directives below.
#   SEEDED - written only when the leaf key is absent, one key at a time. A new
#            dotfiles default reaches existing hosts; a value the TUI or the user
#            set is never touched. Trade-off: a seeded key that is deleted comes
#            back on the next apply. Set it explicitly to keep it.
#            The stock sidebar toggle is migrated to "none" for Sidequest;
#            custom sidebar bindings are preserved.
#   KEPT   - everything else, in its original order, including keys this script
#            has never heard of (newer OpenCode releases add settings).
#
# "plugins" is an ordered array of enablement directives and package
# declarations. The merge drops RETIRED_PLUGINS, which name files or packages
# dotfiles no longer ships, then appends any missing managed entry in managed
# order. Every other entry, and the order of the existing ones, stays put. Local
# entries and later "-id" controls therefore survive. To opt out of a managed
# plugin, append its "-id" control to this array.
#
# An npm entry matches by package name, whatever version it pins. The managed
# pin is OWNED, so a version bump rewrites the existing entry's "package"
# instead of appending a second one. Its "options" are SEEDED per leaf: options
# you edit in this file survive, and a new dotfiles option still arrives. The
# one exception is pills.tier.ramp, which is OWNED by the tierIcons data key so
# changing that key keeps working after the first apply.
#
# opencode-pillbox-statusline draws the footer. Its server half loads from
# opencode.jsonc; the entry here configures the TUI half. The seeded options
# pin the yellow and cyan pills to the palette hues that gud-lucent defines,
# with theme fallbacks for other themes. Full option reference: the package
# README and schema.json.
# Sidequest uses the same server/TUI package pin. Its focusKey option is a leader
# chord that no native binding uses; it is seeded without replacing local choices.
# ./v2-plugins/attention-tabs is a local plugin in the object form, matched by its
# path like any local entry. Its options are SEEDED per leaf: sort (off) and
# jumpKey. The other options (toast, banner, tmuxSink, notifierCommand, debounceMs,
# activeTtlMs) keep their in-plugin defaults so a later default reaches every host.
#
# ~/.config/opencode/cli.override.json is separate and wins at runtime: the
# opencode2 wrapper exports it as OPENCODE_CLI_CONFIG_CONTENT. Nested objects
# merge over this file, but arrays and scalars REPLACE it, so an override that
# sets "plugins" drops every managed plugin unless it restates them.
#
# Safety: if the incoming file is non-empty but is not a JSON object, it is
# emitted unchanged and a warning goes to stderr. Never destroy a hand-edited
# target, never block the rest of the apply.
#
# The file is gated wholesale in home/.chezmoiignore under ai > opencode. It is
# a .tmpl so the check-json hook skips it; its only template value is the
# tierIcons data key ("value" or "heat"), which sets the tier pill's icon ramp.
import copy
import json
import re
import sys

OWNED = "owned"
SEEDED = "seeded"
ENSURED = "ensured"

YELLOW = ["hue.yellow", "feedback.warning"]
CYAN = ["hue.cyan", "hue.accent"]
PILLBOX_OPTIONS = {
    "pills": {
        "git": {"dirtyAccent": YELLOW},
        "identity": {"effortColor": YELLOW},
        "provider": {"warning": YELLOW},
        "spinner": {"accent": CYAN},
        "elapsed": {"accent": CYAN},
        "context": {"accent": CYAN},
        "tier": {"ramp": {{ dig "tierIcons" "value" . | toJson }}},
    },
}

# attention-tabs ships with sorting off until the old Mac focus bug is checked by
# hand; both options are seeded per leaf, so a host that turns sorting on keeps it.
ATTENTION_TABS_OPTIONS = {"sort": False, "jumpKey": "<leader>z"}

MANAGED_PLUGINS = (
    "-opencode.prompt.footer",
    "./v2-plugins/agent-catalog",
    "./v2-plugins/demo",
    {"package": "opencode-pillbox-statusline@latest", "options": PILLBOX_OPTIONS},
    {"package": "opencode-sidequest@latest", "options": {"focusKey": "<leader>p"}},
    {"package": "./v2-plugins/attention-tabs", "options": ATTENTION_TABS_OPTIONS},
)
# The local footer and the stock TUI half it replaced. A stale local path
# fails to load, so the merge removes these instead of leaving them behind.
RETIRED_PLUGINS = (
    "-opencode-copilot-statusline.tui",
    "./v2-plugins/statusline",
)
NPM_SPEC = re.compile(r"(@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)@[^/\s]+")
# Option paths re-asserted from the managed entry on every apply.
OWNED_OPTIONS = (("pills", "tier", "ramp"),)

# (path, value, ownership), applied in order so a first install lists keys in
# this order. tabs.enabled is the legacy form of tabs.mode and loses to it, so
# tabs.mode is not seeded beside an existing tabs.enabled.
SETTINGS = (
    (("$schema",), "https://opencode.ai/v2/cli.json", OWNED),
    (("theme", "name"), "gud-lucent", SEEDED),
    (("theme", "mode"), "system", SEEDED),
    (("tabs", "mode"), "on", SEEDED),
    (("tabs", "scope"), "cwd", SEEDED),
    (("tabs", "layout"), "horizontal", SEEDED),
    (("tabs", "indicators"), "status", SEEDED),
    (("keybinds", "leader"), "ctrl+x", OWNED),
    (("keybinds", "session.tab.previous"), "<leader>h,<leader>left,<leader>k,<leader>up", OWNED),
    (("keybinds", "session.tab.next"), "<leader>l,<leader>right,<leader>j,<leader>down", OWNED),
    (("keybinds", "session.list"), "<leader>t", SEEDED),
    (("keybinds", "agent.cycle"), "shift+tab", SEEDED),
    (("keybinds", "session.first"), "home,<leader>f", OWNED),
    (("keybinds", "session.sidebar.toggle"), "none", SEEDED),
    (("keybinds", "pane.focus.left"), "none", OWNED),
    (("keybinds", "pane.focus.right"), "none", OWNED),
    (("keybinds", "terminal.select"), "none", OWNED),
    (("keybinds", "terminal.close"), "none", OWNED),
    (("keybinds", "terminal.toggle"), "none", OWNED),
    (("keybinds", "theme.switch"), "none", SEEDED),
    (("leader", "timeout"), 1500, OWNED),
    (("attention", "notifications"), False, OWNED),
    (("attention", "sound"), False, OWNED),
    (("plugins",), MANAGED_PLUGINS, ENSURED),
    (("session", "sidebar"), "hide", SEEDED),
    (("session", "permissions"), "prompt", SEEDED),
    (("session", "verbosity"), "high", SEEDED),
    (("session", "new_location"), "inherit", SEEDED),
    (("session", "thinking"), "show", SEEDED),
    (("animations",), True, SEEDED),
    (("diffs", "wrap"), "word", SEEDED),
    (("terminal", "title"), True, SEEDED),
    # ---- Prompt submit keys: Enter inserts a newline, Cmd+Enter submits ----------
    # SEEDED per leaf, so a binding set in the TUI or by hand is never replaced.
    # These ids bind to any focused textarea, which is the main prompt composer.
    # The question form, dialog prompts, the command palette and the autocomplete
    # popup hard-code Enter, so they keep acting on it. Alt+Enter is listed as a
    # submit chord on purpose: tmux without extended-keys delivers Cmd+Enter as
    # Alt+Enter. It must stay out of input.newline, where it sits by default.
    # Ghostty must also release Cmd+Enter; see ghostty/config.tmpl.
    (("keybinds", "input.submit"), "super+return,alt+return", SEEDED),
    (("keybinds", "input.newline"), "return,shift+return,ctrl+return,ctrl+j", SEEDED),
)
SEED_UNLESS = {("tabs", "mode"): (("tabs", "enabled"),)}


def lookup(data, path):
    node = data
    for key in path:
        if not isinstance(node, dict) or key not in node:
            return False
        node = node[key]
    return True


def group(data, path):
    node = data
    for key in path:
        if not isinstance(node.get(key), dict):
            node[key] = {}
        node = node[key]
    return node


def plugin_key(entry):
    """Name an entry; an npm spec matches whatever version it pins."""
    name = entry.get("package") if isinstance(entry, dict) else entry
    if not isinstance(name, str):
        return None
    match = NPM_SPEC.fullmatch(name)
    return match.group(1) if match else name


def seed(target, defaults):
    for key, value in defaults.items():
        if key not in target:
            target[key] = copy.deepcopy(value)
        elif isinstance(target[key], dict) and isinstance(value, dict):
            seed(target[key], value)


def own(options, managed):
    """Re-assert OWNED_OPTIONS from the managed options onto the entry's options."""
    if not isinstance(options, dict) or not isinstance(managed, dict):
        return
    for path in OWNED_OPTIONS:
        value = managed
        for key in path:
            value = value.get(key) if isinstance(value, dict) else None
        if value is None:
            continue
        node = options
        for key in path[:-1]:
            if not isinstance(node.get(key), dict):
                node[key] = {}
            node = node[key]
        node[path[-1]] = copy.deepcopy(value)


def pin(entry, managed):
    """Own a present entry's package spec; seed its options per leaf."""
    if not isinstance(entry, dict):
        return copy.deepcopy(managed)
    if isinstance(managed, dict):
        entry["package"] = managed["package"]
        seed(entry, {key: value for key, value in managed.items() if key != "package"})
        own(entry.get("options"), managed.get("options"))
    else:
        entry["package"] = managed
    return entry


def ensure_plugins(data, key, wanted):
    current = data.get(key)
    retired = {plugin_key(entry) for entry in RETIRED_PLUGINS}
    entries = [entry for entry in (current if isinstance(current, list) else [])
               if plugin_key(entry) not in retired]
    for managed in wanted:
        matches = [i for i, entry in enumerate(entries) if plugin_key(entry) == plugin_key(managed)]
        for i in matches:
            entries[i] = pin(entries[i], managed)
        if not matches:
            entries.append(copy.deepcopy(managed))
    data[key] = entries


def merge(data):
    keybinds = data.get("keybinds")
    # Free the stock sidebar key for Sidequest; keep custom sidebar shortcuts.
    if isinstance(keybinds, dict) and keybinds.get("session.sidebar.toggle") in ("<leader>b", ["<leader>b"]):
        keybinds["session.sidebar.toggle"] = "none"
    for path, value, ownership in SETTINGS:
        if ownership == ENSURED:
            ensure_plugins(data, path[-1], value)
        elif ownership == OWNED:
            group(data, path[:-1])[path[-1]] = value
        elif not lookup(data, path) and not any(
            lookup(data, alias) for alias in SEED_UNLESS.get(path, ())
        ):
            group(data, path[:-1])[path[-1]] = value
    if next(iter(data)) != "$schema":
        data = {"$schema": data.pop("$schema"), **data}
    return data


def main():
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
        if not isinstance(data, dict):
            raise ValueError("root is not a JSON object")
    except ValueError as error:
        print(f"modify_private_cli.json: leaving cli.json unchanged: {error}", file=sys.stderr)
        sys.stdout.write(raw)
        return
    sys.stdout.write(json.dumps(merge(data), indent=2, ensure_ascii=False) + "\n")


main()
