def warn(msg):
    sys.stderr.write("modify_opencode.jsonc: %s\n" % msg)


def skip_ws_comments(text, i):
    """Advance past whitespace and JSONC comments starting at i."""
    n = len(text)
    while i < n:
        c = text[i]
        if c.isspace():
            i += 1
            continue
        if c == "/" and i + 1 < n:
            if text[i + 1] == "/":
                j = text.find("\n", i)
                i = n if j < 0 else j + 1
                continue
            if text[i + 1] == "*":
                j = text.find("*/", i + 2)
                i = n if j < 0 else j + 2
                continue
        break
    return i


def scan(text):
    """Locate the root object and its top-level entries.

    Returns (root_open, root_close, entries) as character offsets. Each entry is
    {name, start, end, sep}: start is the opening quote of the key, sep is the
    separating comma (None for the last entry), end is where the entry's value
    stops. Strings and comments are skipped as units, so a `//` inside a URL and
    a `,` inside a nested object are never mistaken for structure.
    """
    n = len(text)
    i = 0
    depth = 0
    root_open = root_close = None
    entries = []
    cur = None
    while i < n:
        c = text[i]
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            j = text.find("\n", i)
            i = n if j < 0 else j
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        if c == '"':
            j = i + 1
            while j < n:
                if text[j] == "\\":
                    j += 2
                    continue
                if text[j] == '"':
                    break
                j += 1
            # A string at depth 1 followed by `:` is a top-level key. A top-level
            # string VALUE sits at the same depth but is followed by `,` or `}`.
            if depth == 1 and root_open is not None and root_close is None:
                k = skip_ws_comments(text, j + 1)
                if k < n and text[k] == ":":
                    cur = {"name": text[i + 1:j], "start": i, "end": None, "sep": None}
                    entries.append(cur)
            i = j + 1
            continue
        if c in "{[":
            if depth == 0 and c == "{" and root_open is None:
                root_open = i
            depth += 1
            i += 1
            continue
        if c in "}]":
            depth -= 1
            if depth == 0 and c == "}" and root_open is not None and root_close is None:
                root_close = i
                if cur is not None and cur["end"] is None:
                    cur["end"] = i
                    cur = None
            i += 1
            continue
        if c == "," and depth == 1 and root_open is not None and root_close is None:
            if cur is not None and cur["end"] is None:
                cur["end"] = i
                cur["sep"] = i
                cur = None
            i += 1
            continue
        i += 1
    return root_open, root_close, entries


def split_line_comment(line):
    """Split one line into (code, comment); `//` inside a string stays in code."""
    in_str = False
    i = 0
    n = len(line)
    while i < n:
        c = line[i]
        if in_str:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_str = False
            i += 1
            continue
        if c == '"':
            in_str = True
            i += 1
            continue
        if c == "/" and i + 1 < n and line[i + 1] == "/":
            return line[:i], line[i:]
        i += 1
    return line, ""


def set_trailing_comma(block, want):
    """Add or remove the trailing comma on a block's last code line, in place."""
    for i in range(len(block) - 1, -1, -1):
        code, comment = split_line_comment(block[i])
        if not code.strip():
            continue
        stripped = code.rstrip()
        gap = code[len(stripped):] if comment else ""
        if stripped.endswith(","):
            if not want:
                stripped = stripped[:-1].rstrip()
        elif want:
            stripped += ","
        block[i] = stripped + gap + comment
        return True
    return False


def entry_value_start(source, entry):
    """Return the first non-comment byte after an entry's colon."""
    i = entry["start"] + 1
    while i < len(source):
        if source[i] == "\\":
            i += 2
            continue
        if source[i] == '"':
            break
        i += 1
    colon = skip_ws_comments(source, i + 1)
    if colon >= len(source) or source[colon] != ":":
        raise ValueError("entry has no colon")
    return skip_ws_comments(source, colon + 1)


def string_token_end(source, start):
    """Return one past a JSON string without consuming comments or whitespace."""
    if start >= len(source) or source[start] != '"':
        raise ValueError("managed agent color is not a string")
    i = start + 1
    while i < len(source):
        if source[i] == "\\":
            i += 2
            continue
        if source[i] == '"':
            return i + 1
        i += 1
    raise ValueError("unterminated managed agent color")


def line_indent(source, position):
    """Return leading whitespace on the line containing position."""
    start = source.rfind("\n", 0, position) + 1
    prefix = source[start:position]
    return prefix if not prefix.strip() else ""


def insert_object_member(source, root_open, root_close, entries, member):
    """Insert a first object member while leaving existing bytes untouched."""
    if entries:
        indent = line_indent(source, entries[0]["start"])
    else:
        indent = line_indent(source, root_close) + "  "
    if not indent:
        indent = "  "
    comma = "," if entries else ""
    if "\n" in source[root_open:root_close]:
        insertion = "\n%s%s%s" % (indent, member, comma)
    else:
        insertion = " %s%s" % (member, comma)
    return source[:root_open + 1] + insertion + source[root_open + 1:]


def merge_agent_color(agents_block, agent_id, color):
    """Set one built-in color while preserving every other agents byte."""
    root_open, root_close, agents = scan(agents_block)
    if root_open is None or root_close is None:
        raise ValueError("agents is not a complete object")
    agent = next((entry for entry in agents if entry["name"] == agent_id), None)
    if agent is None:
        member = '"%s": { "color": "%s" }' % (agent_id, color)
        return insert_object_member(agents_block, root_open, root_close, agents, member)

    value_start = entry_value_start(agents_block, agent)
    if value_start >= len(agents_block) or agents_block[value_start] != "{":
        raise ValueError("agent %r is not an object" % agent_id)
    agent_source = agents_block[value_start:agent["end"]]
    obj_open, obj_close, fields = scan(agent_source)
    if obj_open is None or obj_close is None:
        raise ValueError("agent %r object is incomplete" % agent_id)
    color_entry = next((entry for entry in fields if entry["name"] == "color"), None)
    if color_entry is None:
        updated = insert_object_member(
            agent_source,
            obj_open,
            obj_close,
            fields,
            '"color": "%s"' % color,
        )
        return agents_block[:value_start] + updated + agents_block[agent["end"]:]

    color_start = entry_value_start(agent_source, color_entry)
    color_end = string_token_end(agent_source, color_start)
    updated = agent_source[:color_start] + '"%s"' % color + agent_source[color_end:]
    return agents_block[:value_start] + updated + agents_block[agent["end"]:]


def merge_agents(agents_block):
    """Apply the two managed colors and leave custom agent configuration alone."""
    # Insert Plan first so a completely missing pair renders Build before Plan.
    agents_block = merge_agent_color(agents_block, "plan", PLAN_COLOR)
    return merge_agent_color(agents_block, "build", BUILD_COLOR)


def build_owned(agents_block):
    """Build the managed top-level entries around a preserved agents block."""
    blocks = [
        OWNED_SCHEMA.split("\n"),
        agents_block.split("\n"),
        OWNED_PLUGINS.split("\n"),
    ]
    for block in blocks[:-1]:
        set_trailing_comma(block, True)
    out = []
    for i, block in enumerate(blocks):
        if i:
            out.append("")
        out.extend(block)
    return out


def render(owned, seed, kept):
    """Assemble header + root object from the owned, seeded, and kept blocks.

    Each block carries a trailing comma only when another block follows it, so
    the result is valid JSON as well as valid JSONC.
    """
    blocks = [list(owned)]
    if seed is not None:
        blocks.append(list(seed))
    if kept:
        blocks.append(list(kept))
    for i, block in enumerate(blocks):
        set_trailing_comma(block, i < len(blocks) - 1)
    out = [HEADER, "{"]
    for i, block in enumerate(blocks):
        if i:
            out.append("")
        out.extend(block)
    out.append("}")
    return "\n".join(out) + "\n"


# Decode explicitly rather than trusting the locale: chezmoi may run this under a
# C/POSIX locale, and a non-ASCII byte anywhere in the preserved mcp block would
# otherwise abort the apply.
text = sys.stdin.buffer.read().decode("utf-8")


def emit(s):
    sys.stdout.buffer.write(s.encode("utf-8"))


# Empty stdin means the target does not exist yet: emit the full generic file,
# native permissions included.
if not text.strip():
    emit(render(build_owned(NEW_AGENTS), SEED_PERMISSIONS.split("\n"), []))
    raise SystemExit(0)

root_open, root_close, entries = scan(text)
lines = text.split("\n")
offsets = []
pos = 0
for ln in lines:
    offsets.append(pos)
    pos += len(ln) + 1


def line_of(idx):
    return bisect.bisect_right(offsets, idx) - 1


def column_of(idx):
    return idx - offsets[line_of(idx)]


def passthrough(reason):
    warn("%s; leaving the target unchanged" % reason)
    emit(text if text.endswith("\n") else text + "\n")
    raise SystemExit(0)


if root_open is None or root_close is None:
    passthrough("no complete top-level JSON object found")

open_line = line_of(root_open)
close_line = line_of(root_close)
if close_line <= open_line:
    passthrough("the root object is on a single line, which line surgery cannot edit")
if lines[open_line][column_of(root_open) + 1:].strip():
    passthrough("content follows `{` on the opening line")
if lines[close_line][:column_of(root_close)].strip():
    passthrough("content precedes `}` on the closing line")
for e in entries:
    if lines[line_of(e["start"])][:column_of(e["start"])].strip():
        passthrough("top-level key %r does not start its own line" % e["name"])

# Return an entry's attached comments and value lines. A comparison copy can have
# its trailing comma normalized without changing the target text.
body_start, body_end = open_line + 1, close_line  # body_end exclusive


def entry_span(entry, include_blank_separator=False):
    first = line_of(entry["start"])
    if entry["sep"] is not None:
        last = line_of(entry["sep"])
    else:
        k = entry["end"] - 1
        while k > entry["start"] and text[k].isspace():
            k -= 1
        last = line_of(k)
    while first - 1 >= body_start and lines[first - 1].lstrip().startswith("//"):
        first -= 1
    if include_blank_separator:
        while last + 1 < body_end and not lines[last + 1].strip():
            last += 1
    return first, last


legacy_permission = False
for entry in entries:
    if entry["name"] != "permission":
        continue
    first, last = entry_span(entry)
    candidate = lines[first:last + 1]
    set_trailing_comma(candidate, False)
    legacy_permission = candidate == LEGACY_SEED_PERMISSION.split("\n")
    break


agents_block = NEW_AGENTS
for entry in entries:
    if entry["name"] != "agents":
        continue
    first, last = entry_span(entry)
    agent_lines = lines[first:last + 1]
    set_trailing_comma(agent_lines, False)
    try:
        agents_block = merge_agents("\n".join(agent_lines))
    except ValueError as exc:
        passthrough("cannot merge agent colors: %s" % exc)
    break


# Line span of every owned entry: its attached leading comment block, its own
# lines, and the blank separator that followed it. Deleting the separator with
# the block is what keeps repeated applies from accumulating blank lines.
drop = set()
for e in entries:
    if e["name"] not in OWNED_KEYS and not (e["name"] == "permission" and legacy_permission):
        continue
    first, last = entry_span(e, include_blank_separator=True)
    drop.update(range(first, last + 1))

kept = [lines[i] for i in range(body_start, body_end) if i not in drop]
while kept and not kept[0].strip():
    kept.pop(0)
while kept and not kept[-1].strip():
    kept.pop()

has_native_permissions = any(e["name"] == "permissions" for e in entries)
has_custom_legacy_permission = any(e["name"] == "permission" for e in entries) and not legacy_permission
seed = None
if not has_native_permissions and not has_custom_legacy_permission:
    seed = SEED_PERMISSIONS.split("\n")
emit(render(build_owned(agents_block), seed, kept))
