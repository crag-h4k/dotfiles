{{- /* ~/.config/opencode/themes/gud-lucent.json
       Native OpenCode V2 theme document: a complete "base" token tree plus one
       mode block. It has no top-level "theme" key, so OpenCode parses it as V2
       instead of migrating it as a V1 theme.

       Hue scales come from .chezmoidata/opencode-theme.yaml, which
       scripts/build-opencode-theme.py generates from the palette catalog.
       Step 200 of every named hue is the exact palette color. Gray runs
       foreground (200), comment (400), selection (600), surface (700), and
       background (800); neutral aliases it. Accent is pink, interactive is
       purple. Backgrounds and raised surfaces are transparent so terminal
       opacity shows through without making text translucent.

       Change colors in the shared palette catalog, never here. */ -}}
{{- $id := dig "palette" "dracula" . -}}
{{- $p := get .palettes $id -}}
{{- $t := get .opencodeTheme $id -}}
{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": {{ $t.categorical | toJson }},
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": {{ $t.on.purple | quote }},
          "$selected": "$hue.interactive.200"
        },
        "secondary": { "base": "$text.muted", "$hovered": "$text.base" },
        "destructive": { "base": {{ $t.on.red | quote }}, "$disabled": "$text.muted" }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.orange.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.blue.200" }
      }
    },
    "background": {
      "base": "transparent",
      "raised": { "base": "transparent", "high": "transparent", "max": "transparent" },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "$hue.neutral.600" },
    "scrollbar": { "base": "$hue.purple.200" },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.200",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": {{ $p.notify.dark_green | quote }},
        "removed": {{ $p.notify.dark_red | quote }},
        "context": "$hue.neutral.700"
      },
      "highlight": { "added": "$hue.green.200", "removed": "$hue.red.200" },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": {{ $p.notify.dark_green | quote }},
          "removed": {{ $p.notify.dark_red | quote }}
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.green.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.yellow.200",
      "number": "$hue.blue.200",
      "type": "$hue.cyan.200",
      "operator": "$hue.purple.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.200",
      "link": "$hue.cyan.200",
      "linkText": "$hue.pink.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.cyan.200",
      "listEnumeration": "$hue.blue.200",
      "image": "$hue.pink.200",
      "imageText": "$hue.yellow.200",
      "codeBlock": "$hue.green.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": { "primary": { "$hovered": "$background.raised.high" } }
      }
    }
  },
  {{ $t.mode | quote }}: {
    "hue": {
{{- range $name := list "gray" "red" "orange" "yellow" "green" "cyan" "blue" "purple" "pink" }}
{{- $scale := get $t.hue $name }}
      {{ $name | quote }}: {
{{- range $step := list "100" "200" "300" "400" "500" "600" "700" "800" "900" }}
        {{ $step | quote }}: {{ get $scale $step | quote }}{{ if ne $step "900" }},{{ end }}
{{- end }}
      },
{{- end }}
      "accent": "$hue.pink",
      "interactive": "$hue.purple",
      "neutral": "$hue.gray"
    }
  }
}
