{{- /* ~/.config/opencode/themes/gud-lucent.json
       OpenCode V2 theme. background/backgroundPanel/backgroundElement resolve
       to "none" so terminal opacity shows through without making text
       translucent. Change colors in the shared palette catalog, never here. */ -}}
{{- $p := get .palettes (dig "palette" "dracula" .) -}}
{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "base": {{ $p.colors.background | quote }},
    "surface": {{ $p.colors.surface | quote }},
    "selection": {{ $p.colors.selection | quote }},
    "foreground": {{ $p.colors.foreground | quote }},
    "comment": {{ $p.colors.comment | quote }},
    "red": {{ $p.colors.red | quote }},
    "green": {{ $p.colors.green | quote }},
    "yellow": {{ $p.colors.yellow | quote }},
    "blue": {{ $p.colors.blue | quote }},
    "purple": {{ $p.colors.purple | quote }},
    "cyan": {{ $p.colors.cyan | quote }},
    "orange": {{ $p.colors.orange | quote }},
    "pink": {{ $p.colors.pink | quote }},
    "greenDim": {{ $p.notify.dark_green | quote }},
    "redDim": {{ $p.notify.dark_red | quote }}
  },
  "theme": {
    "primary": { "dark": "purple", "light": "purple" },
    "secondary": { "dark": "cyan", "light": "cyan" },
    "accent": { "dark": "pink", "light": "pink" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "foreground", "light": "foreground" },
    "textMuted": { "dark": "comment", "light": "comment" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "none", "light": "none" },
    "backgroundElement": { "dark": "none", "light": "none" },
    "border": { "dark": "selection", "light": "selection" },
    "borderActive": { "dark": "purple", "light": "purple" },
    "borderSubtle": { "dark": "surface", "light": "surface" },

    "syntaxComment": { "dark": "comment", "light": "comment" },
    "syntaxKeyword": { "dark": "purple", "light": "purple" },
    "syntaxOperator": { "dark": "purple", "light": "purple" },
    "syntaxFunction": { "dark": "green", "light": "green" },
    "syntaxType": { "dark": "cyan", "light": "cyan" },
    "syntaxString": { "dark": "yellow", "light": "yellow" },
    "syntaxNumber": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "foreground", "light": "foreground" },
    "syntaxPunctuation": { "dark": "foreground", "light": "foreground" },

    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "foreground", "light": "foreground" },
    "diffHunkHeader": { "dark": "comment", "light": "comment" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "greenDim", "light": "greenDim" },
    "diffRemovedBg": { "dark": "redDim", "light": "redDim" },
    "diffContextBg": { "dark": "surface", "light": "surface" },
    "diffLineNumber": { "dark": "comment", "light": "comment" },
    "diffAddedLineNumberBg": { "dark": "greenDim", "light": "greenDim" },
    "diffRemovedLineNumberBg": { "dark": "redDim", "light": "redDim" },

    "markdownText": { "dark": "foreground", "light": "foreground" },
    "markdownHeading": { "dark": "purple", "light": "purple" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownLinkText": { "dark": "pink", "light": "pink" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownCodeBlock": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "comment", "light": "comment" },
    "markdownEmph": { "dark": "yellow", "light": "yellow" },
    "markdownStrong": { "dark": "orange", "light": "orange" },
    "markdownHorizontalRule": { "dark": "comment", "light": "comment" },
    "markdownListItem": { "dark": "cyan", "light": "cyan" },
    "markdownListEnumeration": { "dark": "blue", "light": "blue" },
    "markdownImage": { "dark": "pink", "light": "pink" },
    "markdownImageText": { "dark": "yellow", "light": "yellow" }
  }
}
