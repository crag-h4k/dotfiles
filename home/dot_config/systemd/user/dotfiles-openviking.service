# home/dot_config/systemd/user/dotfiles-openviking.service
[Unit]
Description=Local OpenViking memory service
ConditionPathExists=%h/.openviking/ov.conf

[Service]
Type=simple
ExecStart=%h/.local/bin/openvikingctl run
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
