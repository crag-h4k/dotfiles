*.example
*.ig
# Python bytecode (e.g. from validating modify_*.json scripts). A cached
# modify_*.pyc otherwise looks like a chezmoi modify_ script and gets exec'd.
**/__pycache__
**/*.pyc
# lazy.nvim rewrites lazy-lock.json at runtime (:Lazy sync/update). Let it own
# the file per-machine instead of fighting chezmoi over it. init.lua reproduces
# the plugin set on any host; we just don't pin exact commits across machines.
.config/nvim/lazy-lock.json
{{ if not (dig "components" "zsh" true .) -}}
.zshrc
.zshenv
.zsh
{{ end -}}
{{ if not (dig "components" "tmux" true .) -}}
.tmux.conf
.tmux
{{ end -}}
{{/* notify subsystem is needed by the zsh process notifier, tmux integration,
     Claude hooks, Codex hooks, or the OpenCode notifier bridge (v1 or v2). Keep
     this condition aligned with INSTALL_NOTIFY in
     .chezmoiscripts/run_once_after_00-install.sh.tmpl. */}}
{{ if and
     (not (dig "components" "zsh" true .))
     (not (dig "components" "tmux" true .))
     (not (dig "components" "ai" "claude_hooks" false .))
     (not (dig "components" "ai" "codex_hooks" false .))
     (not (dig "components" "ai" "opencode" false .))
     (not (dig "components" "ai" "opencode2" false .)) -}}
.config/notify
{{ end -}}
{{ if not (dig "components" "neovim" true .) -}}
.config/nvim
{{ end -}}
{{ if not (dig "components" "git" "config" false .) -}}
.gitconfig
{{ end -}}
{{ if not (dig "components" "git" "personal" false .) -}}
.gitconfig.personal
{{ end -}}
{{ if not (dig "components" "git" "ignore_global" true .) -}}
.gitignore_global
{{ end -}}
{{/* settings.json / config.toml are the merge targets for BOTH the notify hooks
     and the statusline, so manage them when EITHER sub-feature is on; ignore only
     when both are off. The hook scripts stay gated by their hooks sub-feature; the
     statusline files by the statusline sub-feature. */}}
{{ if and (not (dig "components" "ai" "claude_hooks" false .)) (not (dig "components" "ai" "statusline" false .)) -}}
.claude/settings.json
{{ end -}}
{{ if not (dig "components" "ai" "claude_hooks" false .) -}}
.claude/hooks/notify-tmux.sh
.claude/hooks/notify-clear.sh
{{ end -}}
{{ if not (dig "components" "ai" "statusline" false .) -}}
.claude/statusline-command.sh
.claude/statusline-tokens.py
.config/statusline
.codex/themes
{{ end -}}
{{ if and (not (dig "components" "ai" "codex_hooks" false .)) (not (dig "components" "ai" "statusline" false .)) -}}
.codex/config.toml
{{ end -}}
{{ if not (dig "components" "ai" "codex_hooks" false .) -}}
.codex/hooks/notify-tmux.sh
{{ end -}}
{{/* OpenCode generic base config + notifier-bridge plugin, SHARED by both the
     opencode (v1) and opencode2 (v2 beta) sub-features (they share one
     ~/.config/opencode/ dir), so these install when EITHER is selected.
     opencode.jsonc is MERGE-managed via modify_opencode.jsonc.tmpl: chezmoi
     asserts $schema + plugin and preserves the work-only instructions/mcp keys
     that live in the target file, so those never reach this public repo. The
     rest of the private work layer (~/.config/opencode/agents and work.ts) is
     NOT managed at all: no source entry exists for .config/opencode/agents, so
     chezmoi leaves those unmanaged local files untouched. */}}
{{ if not (or (dig "components" "ai" "opencode" false .) (dig "components" "ai" "opencode2" false .)) -}}
.config/opencode/opencode.jsonc
.config/opencode/tui.json
.config/opencode/themes/gud.json
.config/opencode/plugin/notify.ts
.config/opencode/commands/iac-scan.md
{{ end -}}
{{/* OpenCode v2-only files: cli.json (v2's config surface, replacing tui.json;
     content owned elsewhere, gated here) and the translucent gud-lucent theme
     v2 points at. Managed only when the opencode2 sub-feature is on. */}}
{{ if not (dig "components" "ai" "opencode2" false .) -}}
.config/opencode/cli.json
.config/opencode/themes/gud-lucent.json
{{ end -}}
{{/* Ghostty config (~/.config/ghostty) is a terminal sub-feature. Cross-platform
     (macOS + Linux), default-on, so the dig default is true. Ignore unless the
     terminal > ghostty sub-feature is selected. */}}
{{ if not (dig "components" "terminal" "ghostty" true .) -}}
.config/ghostty
{{ end -}}
{{/* iterm2 Dynamic Profiles JSON (~/.config/iterm2, symlinked into ~/Library by
     install-iterm2.sh) are macOS-only and opt-in; iterm2 is now a terminal
     sub-feature. Ignore unless we are on darwin AND terminal > iterm2 is selected. */}}
{{ if or (ne .chezmoi.os "darwin") (not (dig "components" "terminal" "iterm2" false .)) -}}
.config/iterm2
{{ end -}}
