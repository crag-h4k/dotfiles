# home/.chezmoiignore
*.example
*.ig
# Python bytecode (e.g. from validating modify_*.json scripts). A cached
# modify_*.pyc otherwise looks like a chezmoi modify_ script and gets exec'd.
**/__pycache__
**/*.pyc
# lazy.nvim rewrites lazy-lock.json at runtime (:Lazy sync/update). Let it own
# the file per-machine instead of fighting chezmoi over it. init.lua reproduces
# the plugin set on any host; we just don't pin exact commits across machines.
.config/nvim/lazy-lock.json
# Machine-local escape hatches: one file per tool for changing this config
# without editing it (see "Local overrides" in docs/operation.md). Every entry is
# unconditional and has no source file: chezmoi never creates, applies, or
# removes them, and `chezmoi add` / `chezmoi re-add` refuse them, so nothing
# local reaches this public repo. Each tool's include is already optional
# (Ghostty `?`, tmux `-q`, git's silent skip, zsh `-r` guard, nvim pcall), so
# there is no stub to seed.
#
# .zsh_private is the separate private file (credentials, private env) that
# .zshrc creates and sources early. Listed here for the same anti-leak reason.
#
# Backup note: run_before_00-backup.sh skips $HOME itself but sweeps every
# directory holding a managed file, so the hatches under .config/ and .tmux/ are
# copied in plaintext into ~/.dotfiles-backup/ (20 snapshots). The $HOME-level
# private files are not, which is the right place for anything sensitive.
#
# local-*.zsh covers $ZSH_CUSTOM/functions/, which .zshrc globs and chezmoi
# manages. A blanket glob there would un-manage the real function files, so
# machine-local additions are guarded by name convention instead.
.config/ghostty/override.conf
.config/git/override.conf
.config/nvim/lua/override.lua
.config/opencode/.runtime-releases
.config/opencode/node_modules
.config/opencode/package.json
.config/opencode/package-lock.json
.tmux/conf.d/override.conf
.tmux/plugins
.local/share/opencode2
.zsh/custom/functions/local-*.zsh
.gitconfig.override
.gitconfig.personal
.gitconfig.work
.zsh_override
.zsh_private
{{/* Writing-quality skills are an automatic child of the existing AI parent.
     Any selected AI sub-feature enables the one canonical skill store, the
     per-skill harness links, and the two OpenCode commands. Keep this expression
     aligned with home/.chezmoiexternal.toml. */}}
{{ $agentSkillsEnabled := or
     (dig "components" "ai" "claude_hooks" false .)
     (dig "components" "ai" "codex_hooks" false .)
     (dig "components" "ai" "statusline" false .)
     (dig "components" "ai" "opencode" false .)
     (dig "components" "ai" "copilot" false .)
     (dig "components" "ai" "codecompanion" false .) -}}
{{ if not $agentSkillsEnabled -}}
.local/share/agent-skills/PROVENANCE.md
.local/share/agent-skills/humanizer
.local/share/agent-skills/unslop-code
.local/share/agent-skills/unslop-text
.local/share/agent-skills/unslop-ui
.claude/skills/humanizer
.claude/skills/unslop-code
.claude/skills/unslop-text
.claude/skills/unslop-ui
.agents/skills/humanizer
.agents/skills/unslop-code
.agents/skills/unslop-text
.agents/skills/unslop-ui
.config/opencode/commands/humanize.md
.config/opencode/commands/unslop.md
{{ end -}}
{{ if not (dig "components" "zsh" true .) -}}
.zshrc
.zshenv
.zsh
{{ end -}}
{{ if not (dig "components" "tmux" true .) -}}
.tmux.conf
.tmux
{{ end -}}
{{/* notify subsystem is needed by the zsh process notifier, tmux integration,
     Claude hooks, Codex hooks, or the OpenCode V2 notifier bridge. Keep
     this condition aligned with INSTALL_NOTIFY in
     .chezmoiscripts/run_once_after_00-install.sh.tmpl. */}}
{{ if and
     (not (dig "components" "zsh" true .))
     (not (dig "components" "tmux" true .))
     (not (dig "components" "ai" "claude_hooks" false .))
     (not (dig "components" "ai" "codex_hooks" false .))
     (not (dig "components" "ai" "opencode" false .)) -}}
.config/notify
{{ end -}}
{{ if not (or (dig "components" "neovim" true .) (dig "components" "ai" "codecompanion" false .)) -}}
.config/nvim
{{ end -}}
{{ if not (dig "components" "git" "config" false .) -}}
.gitconfig
{{ end -}}
{{ if not (dig "components" "git" "ignore_global" true .) -}}
.gitignore_global
{{ end -}}
{{/* settings.json / config.toml are the merge targets for BOTH the notify hooks
     and the statusline, so manage them when EITHER sub-feature is on; ignore only
     when both are off. The hook scripts stay gated by their hooks sub-feature; the
     statusline files by the statusline sub-feature. */}}
{{ if and (not (dig "components" "ai" "claude_hooks" false .)) (not (dig "components" "ai" "statusline" false .)) -}}
.claude/settings.json
{{ end -}}
{{ if not (dig "components" "ai" "claude_hooks" false .) -}}
.claude/hooks/notify-tmux.sh
.claude/hooks/notify-clear.sh
{{ end -}}
{{ if not (dig "components" "ai" "statusline" false .) -}}
.claude/statusline-command.sh
.claude/statusline-tokens.py
.config/statusline
.codex/themes
{{ end -}}
{{ if and (not (dig "components" "ai" "codex_hooks" false .)) (not (dig "components" "ai" "statusline" false .)) -}}
.codex/config.toml
{{ end -}}
{{ if not (dig "components" "ai" "codex_hooks" false .) -}}
.codex/hooks/notify-tmux.sh
{{ end -}}
{{/* OpenCode V2 config, native notifier plugin, and managed
     wrapper install only when ai > opencode is selected.
     opencode.jsonc is MERGE-managed via modify_opencode.jsonc.tmpl: chezmoi
     asserts its V2-owned keys and preserves every unknown top-level key and
     comment. Unmanaged local configuration remains outside this repo. */}}
{{ if not (dig "components" "ai" "opencode" false .) -}}
.config/opencode/opencode.jsonc
.config/opencode/cli.json
.config/opencode/themes/gud-lucent.json
.config/opencode/plugin/notify.ts
.config/opencode/plugin/copilot-tiers.ts
.config/opencode/v2-plugins
.config/opencode/commands/iac-scan.md
.local/bin/opencode2
{{ end -}}
{{/* Ghostty config (~/.config/ghostty) is a terminal sub-feature. Cross-platform
     (macOS + Linux), default-on, so the dig default is true. Ignore unless the
     terminal > ghostty sub-feature is selected. */}}
{{ if not (dig "components" "terminal" "ghostty" true .) -}}
.config/ghostty
{{ end -}}
{{/* iterm2 Dynamic Profiles JSON (~/.config/iterm2, symlinked into ~/Library by
     install-iterm2.sh) are macOS-only and opt-in; iterm2 is now a terminal
     sub-feature. Ignore unless we are on darwin AND terminal > iterm2 is selected. */}}
{{ if or (ne .chezmoi.os "darwin") (not (dig "components" "terminal" "iterm2" false .)) -}}
.config/iterm2
{{ end -}}
