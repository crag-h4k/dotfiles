{{- /* Component selection. Asked once at `chezmoi init` and persisted into   */ -}}
{{- /* ~/.config/chezmoi/chezmoi.toml. apply/update read the stored choice and */ -}}
{{- /* never re-prompt; re-run `chezmoi init` (or edit [data.components]) to   */ -}}
{{- /* change it. Parsed into booleans below so the rest of the repo can gate  */ -}}
{{- /* on .components.* (see .chezmoiignore, .chezmoiexternal.toml).            */ -}}
{{- /*                                                                          */ -}}
{{- /* Single source of truth: add/remove a component by editing this list.    */ -}}
{{- /* Each record is:                                                          */ -}}
{{- /*   num   the menu number the user types to select it (string).           */ -}}
{{- /*   key   the [data.components] boolean key it sets.                       */ -}}
{{- /*   label short name shown in the menu, padded for alignment.             */ -}}
{{- /*   desc  one-line description shown in the menu.                          */ -}}
{{- /*   all   whether the default-on set includes it.                           */ -}}
{{- /* The menu text, the per-component parse, and the [data.components] block  */ -}}
{{- /* are all derived from this list, so a new component is a one-line add.    */ -}}
{{- /* Sub-feature lists for the components that have a nested submenu (git, ai). */ -}}
{{- /* Same record shape as $components. Here `all` means "pre-selected in the    */ -}}
{{- /* submenu by default", which is also the no-tty / Enter fallback selection.   */ -}}
{{- $gitFeatures := list
    (dict "num" "1" "key" "config"        "label" "managed config" "desc" "~/.gitconfig + private ~/.gitconfig.override stub" "all" false)
    (dict "num" "3" "key" "ignore_global" "label" "global ignore"  "desc" "~/.gitignore_global"                         "all" true)
-}}
{{- /* OpenCode V2 is the AI submenu default. CodeCompanion is deliberately last */ -}}
{{- /* and off by default because it installs Neovim, Node, and claude-agent-acp. */ -}}
{{- $aiFeatures := list
    (dict "num" "1" "key" "claude_hooks"  "label" "claude_hooks"  "desc" "Claude settings.json notify hooks"           "all" false)
    (dict "num" "2" "key" "codex_hooks"   "label" "codex_hooks"   "desc" "Codex config.toml notify hook"               "all" false)
    (dict "num" "3" "key" "statusline"    "label" "statusline"    "desc" "Claude token/context statusline + matching Codex theme" "all" false)
    (dict "num" "4" "key" "opencode"      "label" "opencode"      "desc" "OpenCode V2 + managed standalone wrapper + tmux notifier" "all" true)
    (dict "num" "5" "key" "copilot"       "label" "copilot"       "desc" "GitHub Copilot CLI (npm @github/copilot; pulls in the copilot binary)" "all" false)
    (dict "num" "6" "key" "codecompanion" "label" "codecompanion" "desc" "CodeCompanion.nvim assistant (also installs Neovim, Node + claude-agent-acp)" "all" false)
-}}
{{- /* Terminal-emulator sub-features. MULTI-select (like git/ai): installing more */ -}}
{{- /* than one emulator's config is harmless and Dane runs both, so this is not a  */ -}}
{{- /* single-primary picker. ghostty is the cross-platform default (all=true);      */ -}}
{{- /* iterm2 is macOS-only, so it carries an `os` tag that hides it from the submenu */ -}}
{{- /* on non-macOS (the data key is still emitted for column parity, and the file   */ -}}
{{- /* gate in .chezmoiignore also enforces darwin). Non-os features leave `os` "".   */ -}}
{{- $terminalFeatures := list
    (dict "num" "1" "key" "ghostty" "label" "ghostty" "desc" "Ghostty config + quick-terminal dropdown (macOS + Linux)" "all" true  "os" "")
    (dict "num" "2" "key" "iterm2"  "label" "iterm2"  "desc" "iTerm2 Dynamic Profiles (macOS only)"                     "all" false "os" "darwin")
-}}
{{- /* Top-level components. git, ai, and terminal carry a `sub` feature list plus */ -}}
{{- /* the submenu's persisted selection key and header; the rest have an empty    */ -}}
{{- /* `sub` and are emitted as bare booleans under [data.components].             */ -}}
{{- $components := list
    (dict "num" "1" "key" "zsh"      "label" "Zsh"                "desc" "oh-my-zsh, plugins, custom functions, aliases"  "all" true  "sub" (list))
    (dict "num" "2" "key" "tmux"     "label" "tmux"               "desc" "tmux + plugins (tpm, resurrect, sensible, yank)" "all" true  "sub" (list))
    (dict "num" "3" "key" "neovim"   "label" "Neovim"             "desc" "Neovim, lazy.nvim, language servers, linters"   "all" true  "sub" (list))
    (dict "num" "4" "key" "git"      "label" "Git"                "desc" "managed config and independent global ignore"   "all" true  "sub" $gitFeatures "selKey" "gitSelection" "header" "Git configuration")
    (dict "num" "5" "key" "ai"       "label" "AI tools"           "desc" "OpenCode V2, hooks, statusline, Copilot, CodeCompanion" "all" false "sub" $aiFeatures  "selKey" "aiSelection"  "header" "AI tools")
    (dict "num" "6" "key" "terminal" "label" "terminal emulators" "desc" "independent Ghostty and iTerm2 configuration"    "all" false "sub" $terminalFeatures "selKey" "terminalSelection" "header" "Terminal emulators")
-}}
{{- /* Init-time actions are shown separately and never persisted as components. */ -}}
{{- $actions := list
    (dict "num" "7" "key" "colorscheme" "label" "theme"        "desc" (printf "choose the shared color theme (current: %s; unchecked keeps it)" (dig "palette" "dracula" .)) "all" false "sub" (list) "action" true)
    (dict "num" "8" "key" "install_mode" "label" "package mode" "desc" (printf "choose configs-only or package installation (current: %s; unchecked keeps it)" (dig "installMode" "packages" .)) "all" false "sub" (list) "action" true)
-}}
{{- $topItems := list -}}
{{- range $components }}{{- $topItems = append $topItems . }}{{- end -}}
{{- range $actions }}{{- $topItems = append $topItems . }}{{- end -}}
{{- /* Build the numbered menu text from the list. labels are padded to the    */ -}}
{{- /* width of the widest label so descriptions line up.                       */ -}}
{{- $labelWidth := 0 -}}
{{- range $topItems }}{{- $labelWidth = max $labelWidth (len .label) }}{{- end -}}
{{- $lines := list "Components to install:" -}}
{{- range $components -}}
{{- $lines = append $lines (printf "  %s) %s %s" .num (printf "%-*s" (int $labelWidth) .label) .desc) -}}
{{- end -}}
{{- $lines = append $lines "" -}}
{{- $lines = append $lines "Setup actions:" -}}
{{- range $actions -}}
{{- $lines = append $lines (printf "  %s) %s %s" .num (printf "%-*s" (int $labelWidth) .label) .desc) -}}
{{- end -}}
{{- /* Default = component numbers with all=true, space-joined (e.g. "1 2 3"). */ -}}
{{- $defaultNums := list -}}
{{- range $components }}{{- if .all }}{{- $defaultNums = append $defaultNums .num }}{{- end }}{{- end -}}
{{- $default := join " " $defaultNums -}}
{{- $menu := join "\n" $lines -}}
{{- $menu = printf "%s\n\n  default  the default component set (%s)\n\nEnter numbers (e.g. \"1 3\"), type default, or press Enter for default (%s)" $menu $default $default -}}
{{- /* Interactive selection. With gum installed, show a checkbox TUI built from */ -}}
{{- /* the same $components list (a new component appears automatically).        */ -}}
{{- /* gum choose --no-limit renders checkboxes; selected lines go to stdout.   */ -}}
{{- /* Reading </dev/tty keeps it interactive under chezmoi, and `|| true` makes */ -}}
{{- /* no-tty / Esc yield an empty pick. When gum is absent (e.g. the very      */ -}}
{{- /* first apply on a fresh host before install.sh runs) or returns nothing,   */ -}}
{{- /* fall through to the typed promptStringOnce menu below.                    */ -}}
{{- /* DOTFILES_NO_TUI forces the typed menu (used by validate-templates.sh to  */ -}}
{{- /* exercise the parser deterministically, and handy to bypass the TUI).      */ -}}
{{- $packageUpdateValue := lower (trim (env "DOTFILES_PACKAGE_UPDATE")) -}}
{{- $packageUpdate := has $packageUpdateValue (list "1" "true" "yes" "y") -}}
{{- $sel := "" -}}
{{- if and (lookPath "gum") (not (env "DOTFILES_NO_TUI")) (not $packageUpdate) -}}
{{- /* Precompute the comma-sanitized option string per component ONCE. gum splits */ -}}
{{- /* --selected on commas, so any option text containing a comma could never be   */ -}}
{{- /* pre-checked; swap ", " -> "/" so --selected and the positional options stay   */ -}}
{{- /* byte-identical and comma-free (gum matches --selected by exact string).       */ -}}
{{-   $optOf := dict -}}
{{- /* Bold the component label; space out slash-joined desc items. The ", "->" / " */ -}}
{{- /* swap keeps the option comma-free so gum's --selected match still works.       */ -}}
{{-   range $topItems }}{{- $optOf = set $optOf .num (printf "%s) \033[1m%s\033[0m - %s" .num .label (.desc | replace ", " " / " | replace "," " / ")) -}}{{- end -}}
{{-   $opts := list -}}
{{-   range $topItems }}{{- $opts = append $opts (squote (get $optOf .num)) -}}{{- end -}}
{{-   $hdr := "Components first, setup actions last  (space toggles, enter confirms, esc cancels):" -}}
{{- /* Seed --selected so a re-init pre-checks whatever is currently enabled. The   */ -}}
{{- /* truth is the persisted [data.components.*] resolution, not the raw selection */ -}}
{{- /* string (which would miss the `default` keyword form). A fresh init has no */ -}}
{{- /* persisted data, so it pre-checks the default-on set instead.                  */ -}}
{{-   $prevSel := dig "componentSelection" "" . -}}
{{-   $topSeed := list -}}
{{-   if eq $prevSel "" -}}
{{-     range $components }}{{- if .all }}{{- $topSeed = append $topSeed (get $optOf .num) -}}{{- end -}}{{- end -}}
{{-   else -}}
{{- /* "Currently on" = the bare bool is true, or (for the nested git/ai/terminal   */ -}}
{{- /* tables) any of its sub-features is true. Also drives the [current: ...] hint. */ -}}
{{-     $curLabels := list -}}
{{-     range $c := $components -}}
{{-       $on := false -}}
{{-       if eq (len $c.sub) 0 -}}
{{-         $on = dig "components" $c.key false $ -}}
{{-       else -}}
{{-         range $sf := $c.sub -}}
{{-           $featureOn := dig "components" $c.key $sf.key false $ -}}
{{-           if and (eq $c.key "ai") (eq $sf.key "opencode") }}{{- $featureOn = or $featureOn (dig "components" "ai" "opencode2" false $) -}}{{- end -}}
{{-           if and (eq $c.key "git") (eq $sf.key "config") }}{{- $featureOn = or $featureOn (dig "components" "git" "personal" false $) -}}{{- end -}}
{{-           if $featureOn }}{{- $on = true -}}{{- end -}}
{{-         end -}}
{{-       end -}}
{{-       if $on }}{{- $topSeed = append $topSeed (get $optOf $c.num) -}}{{- $curLabels = append $curLabels $c.label -}}{{- end -}}
{{-     end -}}
{{-     $hdr = printf "%s  [current: %s]" $hdr (join ", " $curLabels) -}}
{{-   end -}}
{{-   $selFlag := "" -}}
{{-   if gt (len $topSeed) 0 }}{{- $selFlag = printf "--selected=%s" (join "," $topSeed | squote) -}}{{- end -}}
{{-   $cmd := printf "test -e /dev/tty && gum choose --no-limit %s --header %s %s </dev/tty 2>/dev/tty || true" $selFlag ($hdr | squote) (join " " $opts) -}}
{{- /* Each chosen line starts with "<num>)"; take the leading number, join.     */ -}}
{{-   $nums := list -}}
{{-   range (splitList "\n" (trim (output "sh" "-c" $cmd))) }}{{- if . }}{{- $nums = append $nums (first (splitList ")" .)) -}}{{- end -}}{{- end -}}
{{-   $sel = trim (join " " $nums) -}}
{{- end -}}
{{- if eq $sel "" -}}
{{-   $sel = trim (promptStringOnce . "componentSelection" $menu) -}}
{{- end -}}
{{- /* Empty = pressed Enter. A value starting with the menu text means a    */ -}}
{{- /* non-interactive init (no tty) echoed the prompt back; both fall to the */ -}}
{{- /* default so a piped/CI install never persists a garbage selection.      */ -}}
{{- if or (eq $sel "") (hasPrefix "Components to install" $sel) }}{{- $sel = "default" }}{{- end -}}
{{- /* The retired `all+` selected every old component. Migrate it to explicit */ -}}
{{- /* current component numbers without replaying the two one-shot actions. */ -}}
{{- $legacyAllPlus := eq $sel "all+" -}}
{{- if $legacyAllPlus }}{{- $sel = "1 2 3 4 5 6" -}}{{- end -}}
{{- /* `all` remains a read-only migration alias for persisted old configs. */ -}}
{{- $useDefault := or (eq $sel "default") (eq $sel "all") -}}
{{- if eq $sel "all" }}{{- $sel = "default" -}}{{- end -}}
{{- /* Build the SET of selected component numbers from $sel. Split on          */ -}}
{{- /* whitespace and commas into tokens; a token that exactly matches a         */ -}}
{{- /* component number selects that component. A pure-digit token that is NOT   */ -}}
{{- /* itself a component number expands into its individual digits, so the      */ -}}
{{- /* no-space shorthand "13" still means 1 and 3 - while a real two-digit      */ -}}
{{- /* number ("10", once a 10th component exists) matches component 10 instead  */ -}}
{{- /* of substring-matching component 1. Spacing/order/commas stay irrelevant:  */ -}}
{{- /* "1 3", "13", "3 1", "1,3" are equivalent.                                 */ -}}
{{- $compNums := list -}}
{{- range $topItems }}{{- $compNums = append $compNums .num -}}{{- end -}}
{{- $selSet := dict -}}
{{- range (splitList " " (trim (replace "," " " $sel))) -}}
{{-   if ne . "" -}}
{{-     if has . $compNums -}}
{{-       $selSet = set $selSet . true -}}
{{-     else if regexMatch "^[0-9]+$" . -}}
{{-       range (splitList "" .) }}{{- $selSet = set $selSet . true -}}{{- end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /* Resolve each component/action from the default set or explicit numbers. */ -}}
{{- $resolved := dict -}}
{{- range $topItems -}}
{{- $on := or (and $useDefault .all) (hasKey $selSet .num) -}}
{{- $resolved = set $resolved .key $on -}}
{{- end -}}
{{- /* Nested submenus. For each top-level component that is ON and has a `sub`  */ -}}
{{- /* features list (git, ai), pick its sub-features. Mirrors the top menu: a    */ -}}
{{- /* gum checkbox TUI when available, else a typed promptStringOnce; no-tty /    */ -}}
{{- /* DOTFILES_NO_TUI / Enter falls back to the `all`-flagged sub-defaults. gum   */ -}}
{{- /* submenu options start with the feature key and avoid newer flags such as    */ -}}
{{- /* --label-delimiter, so Debian-packaged gum builds work too. --selected gets */ -}}
{{- /* full option strings; stdout is parsed back to the leading key. The resolve  */ -}}
{{- /* accepts either keys (gum) or numbers (typed) via `contains`.                */ -}}
{{- $subResolved := dict -}}
{{- $subSelStore := dict -}}
{{- /* range rebinds `.` to the element, so capture the root data for dig /     */ -}}
{{- /* promptStringOnce (which must read the persisted [data] selection keys).   */ -}}
{{- $root := . -}}
{{- range $c := $components -}}
{{-   if gt (len $c.sub) 0 -}}
{{-     $feats := $c.sub -}}
{{- /* $menuFeats is $feats minus sub-features whose `os` tag does not match this   */ -}}
{{- /* OS (e.g. iterm2 on Linux). Used ONLY for what the submenu DISPLAYS/offers.    */ -}}
{{- /* Resolution and the emitted data keys below still range the full $feats so     */ -}}
{{- /* column parity holds across OSes and the file-layer gate stays authoritative.  */ -}}
{{-     $menuFeats := list -}}
{{-     range $feats }}{{ $fos := dig "os" "" . }}{{ if or (eq $fos "") (eq $fos $root.chezmoi.os) }}{{ $menuFeats = append $menuFeats . }}{{ end }}{{ end -}}
{{-     $subDefaultKeys := list -}}
{{-     range $feats }}{{ if .all }}{{ $subDefaultKeys = append $subDefaultKeys .key }}{{ end }}{{ end -}}
{{-     $subDefault := join " " $subDefaultKeys -}}
{{-     $r := dict -}}
{{-     $stored := "" -}}
{{-     if get $resolved $c.key -}}
{{-       $subSel := "" -}}
{{- /* `default` takes the sub-defaults without prompting (the guard below        */ -}}
{{- /* defaults an empty $subSel); only an explicit per-number selection prompts. */ -}}
{{-       if $legacyAllPlus -}}
{{- /* Do not re-prompt while migrating `all+`. Start from its persisted raw */ -}}
{{- /* submenu selection, then union in resolved booleans below. */ -}}
{{-         $subSel = dig $c.selKey "" $root -}}
{{-       else if not $useDefault -}}
{{-       if and (lookPath "gum") (not (env "DOTFILES_NO_TUI")) (not $packageUpdate) -}}
{{-         $prevSub := dig $c.selKey "" $root -}}
{{- /* Comma-sanitized sub-feature option string, computed ONCE so --selected and  */ -}}
{{- /* the positional options stay identical and comma-free (see the top-menu note; */ -}}
{{- /* codecompanion's "node, npm" desc is why the previous seed never pre-checked). */ -}}
{{-         $subOptOf := dict -}}
{{-         range $menuFeats }}{{ $subOptOf = set $subOptOf .key (printf "%s - %s" .key (.desc | replace ", " "/" | replace "," "/")) }}{{ end -}}
{{-         $seedOpts := list -}}
{{-         if eq $prevSub "" -}}
{{- /* fresh, or the parent was just turned on: pre-check the sub-defaults. */ -}}
{{-           range $menuFeats }}{{ if .all }}{{ $seedOpts = append $seedOpts (get $subOptOf .key) }}{{ end }}{{ end -}}
{{-         else -}}
{{- /* re-run: pre-check whatever is currently enabled (persisted resolved state). */ -}}
{{-           range $menuFeats -}}
{{-             $featureOn := dig "components" $c.key .key false $root -}}
{{-             if and (eq $c.key "ai") (eq .key "opencode") }}{{- $featureOn = or $featureOn (dig "components" "ai" "opencode2" false $root) -}}{{- end -}}
{{-             if and (eq $c.key "git") (eq .key "config") }}{{- $featureOn = or $featureOn (dig "components" "git" "personal" false $root) -}}{{- end -}}
{{-             if $featureOn }}{{ $seedOpts = append $seedOpts (get $subOptOf .key) }}{{ end -}}
{{-           end -}}
{{-         end -}}
{{-         $subOpts := list -}}
{{-         range $menuFeats }}{{ $subOpts = append $subOpts (squote (get $subOptOf .key)) }}{{ end -}}
{{-         $subHdr := printf "%s  (space toggles, enter confirms, esc cancels):" $c.header -}}
{{-         $subSelFlag := "" -}}
{{-         if gt (len $seedOpts) 0 }}{{ $subSelFlag = printf "--selected=%s" (join "," $seedOpts | squote) }}{{ end -}}
{{-         $subCmd := printf "test -e /dev/tty && gum choose --no-limit %s --header %s %s </dev/tty 2>/dev/tty || true" $subSelFlag ($subHdr | squote) (join " " $subOpts) -}}
{{-         $picked := list -}}
{{-         range (splitList "\n" (trim (output "sh" "-c" $subCmd))) }}{{ if . }}{{ $picked = append $picked (first (splitList " " .)) }}{{ end }}{{ end -}}
{{-         $subSel = trim (join " " $picked) -}}
{{-       end -}}
{{-       if eq $subSel "" -}}
{{-         $subLines := list (printf "%s (enter numbers or keys):" $c.header) -}}
{{-         range $menuFeats }}{{ $subLines = append $subLines (printf "  %s) %s - %s" .num .label .desc) }}{{ end -}}
{{-         $subPrompt := printf "%s\n\nEnter (e.g. \"1 3\"), or press Enter for default (%s)" (join "\n" $subLines) $subDefault -}}
{{-         $subSel = trim (promptStringOnce $root $c.selKey $subPrompt) -}}
{{-       end -}}
{{-       end -}}
{{-       if or (eq $subSel "") (hasPrefix $c.header $subSel) }}{{ $subSel = $subDefault }}{{ end -}}
{{- /* Match by whole token, not substring. Split $subSel on spaces/commas into a  */ -}}
{{- /* set (gum yields leading keys; the typed menu yields keys or numbers), then a  */ -}}
{{- /* feature is on iff its key OR its num is a token. The old substring `contains`  */ -}}
{{- /* false-matched superstring keys or embedded digits. Mirrors $selSet above. */ -}}
{{-       $subTokens := dict -}}
{{-       range (splitList " " (trim (replace "," " " $subSel))) }}{{ if ne . "" }}{{ $subTokens = set $subTokens . true }}{{ end }}{{ end -}}
{{- /* An old `all+` config may carry newer resolved booleans than its raw */ -}}
{{- /* submenu string. Preserve the union so migration cannot disable a feature. */ -}}
{{-       if $legacyAllPlus -}}
{{-         range $feats }}{{- if dig "components" $c.key .key false $root }}{{- $subTokens = set $subTokens .key true }}{{- end }}{{- end -}}
{{-       end -}}
{{- /* Persisted OpenCode V2 selections used the old `opencode2` key/number 7. */ -}}
{{-       if and (eq $c.key "ai") (or (hasKey $subTokens "opencode2") (hasKey $subTokens "7") (dig "components" "ai" "opencode2" false $root)) }}{{- $subTokens = set $subTokens "opencode" true }}{{- end -}}
{{- /* Personal identity used to be a peer of managed Git config. Promote a */ -}}
{{- /* personal-only old selection to managed config before resolving fields. */ -}}
{{-       if and (eq $c.key "git") (or (hasKey $subTokens "personal") (hasKey $subTokens "2") (dig "components" "git" "personal" false $root)) }}{{- $subTokens = set $subTokens "config" true }}{{- end -}}
{{-       range $feats }}{{ $r = set $r .key (or (hasKey $subTokens .key) (hasKey $subTokens .num)) }}{{ end -}}
{{-       $storedKeys := list -}}
{{-       range $feats }}{{ if get $r .key }}{{ $storedKeys = append $storedKeys .key }}{{ end }}{{ end -}}
{{-       $stored = join " " $storedKeys -}}
{{-     else -}}
{{-       range $feats }}{{ $r = set $r .key false }}{{ end -}}
{{-     end -}}
{{-     $subResolved = set $subResolved $c.key $r -}}
{{-     $subSelStore = set $subSelStore $c.key $stored -}}
{{-   end -}}
{{- end -}}

{{- /* CodeCompanion cannot run without Neovim, so selecting it enables the */ -}}
{{- /* Neovim component before package planning and confirmation. */ -}}
{{- if get (get $subResolved "ai") "codecompanion" -}}
{{-   $resolved = set $resolved "neovim" true -}}
{{- end -}}

{{- /* Global palette selection. Color values live in .chezmoidata/palettes.yaml;   */ -}}
{{- /* the generated $paletteDefs list below carries stable ids and names because    */ -}}
{{- /* chezmoi does not load .chezmoidata while rendering this config template. The   */ -}}
{{- /* picker runs only when the `colorscheme` action was checked this init: a        */ -}}
{{- /* searchable Gum list when available, numbered promptString otherwise.           */ -}}
{{- /* Unchecked keeps the current palette.                                            */ -}}
{{- /* current palette and echoes it. DOTFILES_PALETTE sets it for automation;        */ -}}
{{- /* DOTFILES_NO_TUI keeps validation on the persisted value.                       */ -}}
{{- /* GENERATED-PALETTES-BEGIN (scripts/build-palettes.py; do not edit by hand) */ -}}
{{- $paletteDefs := list
    (dict "id" "dracula" "name" "Dracula")
    (dict "id" "catppuccin-mocha" "name" "Catppuccin Mocha")
    (dict "id" "catppuccin-macchiato" "name" "Catppuccin Macchiato")
    (dict "id" "catppuccin-frappe" "name" "Catppuccin Frappe")
    (dict "id" "gruvbox-dark" "name" "Gruvbox Dark")
    (dict "id" "gruvbox-dark-hard" "name" "Gruvbox Dark Hard")
    (dict "id" "gruvbox-material" "name" "Gruvbox Material")
    (dict "id" "tokyo-night" "name" "Tokyo Night")
    (dict "id" "nord" "name" "Nord")
    (dict "id" "rose-pine" "name" "Rose Pine")
    (dict "id" "rose-pine-moon" "name" "Rose Pine Moon")
    (dict "id" "everforest" "name" "Everforest")
    (dict "id" "kanagawa" "name" "Kanagawa")
    (dict "id" "onedark" "name" "One Dark")
    (dict "id" "solarized-dark" "name" "Solarized Dark")
-}}
{{- /* GENERATED-PALETTES-END */ -}}
{{- $paletteIDs := list -}}
{{- range $paletteDefs }}{{- $paletteIDs = append $paletteIDs .id -}}{{- end -}}
{{- $palette := dig "palette" "dracula" $root -}}
{{- if not (has $palette $paletteIDs) }}{{- $palette = "dracula" -}}{{- end -}}
{{- $wantPick := get $resolved "colorscheme" -}}
{{- $paletteInput := "" -}}
{{- if $wantPick -}}
{{-   $paletteInput = trim (env "DOTFILES_PALETTE") -}}
{{-   if and (eq $paletteInput "") (not (env "DOTFILES_NO_TUI")) -}}
{{-     if and (lookPath "gum") (stdinIsATTY) -}}
{{-       $paletteOpts := list -}}
{{-       $paletteOptOf := dict -}}
{{-       range $paletteDefs }}{{- $paletteOptOf = set $paletteOptOf .id (printf "%s (%s)" .name .id) -}}{{- end -}}
{{-       range $paletteDefs }}{{- $paletteOpts = append $paletteOpts (squote (get $paletteOptOf .id)) -}}{{- end -}}
{{-       $pcmd := printf "test -e /dev/tty && gum filter --header %s --placeholder %s --selected %s %s </dev/tty 2>/dev/tty || true" (squote "Pick a color theme") (squote "Type to filter themes...") (squote (get $paletteOptOf $palette)) (join " " $paletteOpts) -}}
{{-       $paletteChoice := trim (output "sh" "-c" $pcmd) -}}
{{-       range $paletteDefs }}{{- if eq $paletteChoice (get $paletteOptOf .id) }}{{- $paletteInput = .id -}}{{- end }}{{- end -}}
{{-     else -}}
{{-       $paletteLines := list "Color themes:" -}}
{{-       range $idx, $definition := $paletteDefs }}{{- $paletteLines = append $paletteLines (printf "  %d) %s" (add1 $idx) $definition.name) -}}{{- end -}}
{{-       $palettePrompt := printf "%s\n\nEnter a number; press Enter to keep %s" (join "\n" $paletteLines) $palette -}}
{{-       $paletteInput = trim (promptString $palettePrompt "") -}}
{{-     end -}}
{{-   end -}}
{{-   if ne $paletteInput "" -}}
{{-     if regexMatch "^[0-9]+$" $paletteInput -}}
{{-       $numberedPalette := "" -}}
{{-       range $idx, $definition := $paletteDefs }}{{- if eq $paletteInput (printf "%d" (add1 $idx)) }}{{- $numberedPalette = $definition.id -}}{{- end }}{{- end -}}
{{-       $paletteInput = $numberedPalette -}}
{{-     else -}}
{{-       $paletteInput = $paletteInput | lower | replace "_" "-" | replace " " "-" -}}
{{-     end -}}
{{-     if not (has $paletteInput $paletteIDs) -}}
{{-       fail (printf "Unknown palette selection %q. Choose a listed number or set DOTFILES_PALETTE to one of: %s" $paletteInput (join ", " $paletteIDs)) -}}
{{-     end -}}
{{-     $palette = $paletteInput -}}
{{-   end -}}
{{- else if and (not (env "DOTFILES_NO_TUI")) (stdinIsATTY) -}}
{{-   $keepName := $palette -}}
{{-   range $paletteDefs }}{{- if eq .id $palette }}{{- $keepName = .name -}}{{- end -}}{{- end -}}
{{-   $msg := printf "keeping %s color scheme" $keepName -}}
{{-   $_ := output "sh" "-c" (printf "printf '%%s\\n' %s >/dev/tty 2>/dev/null || true" (squote $msg)) -}}
{{- end -}}
{{- $zshTheme := dig "zshTheme" "gud" $root -}}
{{- /* Final confirmation happens inside the init template, before chezmoi applies */ -}}
{{- /* any target files. The helper and install.sh consume the same package planner. */ -}}
{{- $notifyEnabled := or
      (get $resolved "zsh")
      (get $resolved "tmux")
      (get (get $subResolved "ai") "claude_hooks")
      (get (get $subResolved "ai") "codex_hooks")
      (get (get $subResolved "ai") "opencode") -}}
{{- $confirmEnv := list
      (printf "INSTALL_ZSH=%t" (get $resolved "zsh"))
      (printf "INSTALL_TMUX=%t" (get $resolved "tmux"))
      (printf "INSTALL_NEOVIM=%t" (get $resolved "neovim"))
      (printf "INSTALL_NOTIFY=%t" $notifyEnabled)
      (printf "INSTALL_AI_CODECOMPANION=%t" (get (get $subResolved "ai") "codecompanion"))
      (printf "INSTALL_AI_STATUSLINE=%t" (get (get $subResolved "ai") "statusline"))
      (printf "INSTALL_AI_OPENCODE=%t" (get (get $subResolved "ai") "opencode"))
      (printf "INSTALL_AI_COPILOT=%t" (get (get $subResolved "ai") "copilot"))
      (printf "INSTALL_TERMINAL_GHOSTTY=%t" (get (get $subResolved "terminal") "ghostty"))
      (printf "INSTALL_TERMINAL_ITERM2=%t" (get (get $subResolved "terminal") "iterm2"))
-}}
{{- $installMode := env "DOTFILES_INSTALL_MODE" -}}
{{- $packageRun := int (dig "packageRun" 0 $root) -}}
{{- /* Reuse the persisted installMode on a re-init so `chezmoi init` does not re-show */ -}}
{{- /* the package plan + mode prompt every time. A first init (no persisted value)    */ -}}
{{- /* still prompts; DOTFILES_INSTALL_MODE still overrides. Package install/upgrade is */ -}}
{{- /* confirmed at install time by install.sh's pkg_confirm (and by `cup`), not here.  */ -}}
{{- if eq $installMode "" }}{{- $installMode = dig "installMode" "" $root }}{{- end -}}
{{- if and (ne $installMode "") (ne $installMode "configs") (ne $installMode "packages") -}}
{{-   fail "DOTFILES_INSTALL_MODE must be 'configs' or 'packages'" -}}
{{- end -}}
{{- $assumeYesValue := lower (trim (env "DOTFILES_ASSUME_YES")) -}}
{{- $assumeYes := has $assumeYesValue (list "1" "true" "yes" "y") -}}
{{- $headlessPackageUpdate := and $packageUpdate (not (stdinIsATTY)) -}}
{{- if $headlessPackageUpdate -}}
{{-   if or (ne (env "DOTFILES_INSTALL_MODE") "packages") (not $assumeYes) -}}
{{-     fail "Headless package update requires DOTFILES_PACKAGE_UPDATE=1, DOTFILES_INSTALL_MODE=packages, and DOTFILES_ASSUME_YES=1" -}}
{{-   end -}}
{{-   $installMode = "packages" -}}
{{- end -}}
{{- /* Show the plan + packages/configs prompt on a first init (no persisted mode) or */ -}}
{{- /* when the `install_mode` toggle was checked this interactive init. Automation     */ -}}
{{- /* (DOTFILES_INSTALL_MODE / DOTFILES_NO_TUI / no tty) never re-prompts.              */ -}}
{{- /* DOTFILES_PACKAGE_UPDATE is the scoped `cup` re-init path. It keeps the     */ -}}
{{- /* persisted component/sub-feature selections, then opens only this mode      */ -}}
{{- /* confirmation. Choosing packages increments packageRun, which changes the    */ -}}
{{- /* rendered run_once content without deleting unrelated chezmoi script state.  */ -}}
{{- $wantMode := or (eq $installMode "") (and (or (get $resolved "install_mode") $packageUpdate) (eq (env "DOTFILES_INSTALL_MODE") "") (not (env "DOTFILES_NO_TUI")) (stdinIsATTY)) -}}
{{- if $wantMode -}}
{{-   $hasTTY := trim (output "sh" "-c" "test -e /dev/tty && (: </dev/tty) 2>/dev/null && printf tty || true") -}}
{{-   if eq $hasTTY "" -}}
{{-     fail "No controlling terminal. Set DOTFILES_INSTALL_MODE=configs or DOTFILES_INSTALL_MODE=packages before chezmoi init." -}}
{{-   end -}}
{{-   $confirmCmd := printf "env %s bash %s" (join " " $confirmEnv) (.chezmoi.sourceDir | dir | printf "%s/scripts/confirm-install.sh" | squote) -}}
{{-   $installMode = trim (output "sh" "-c" $confirmCmd) -}}
{{-   if eq $installMode "exit" }}{{- fail "Installation cancelled before apply" -}}{{- end -}}
{{-   if and (ne $installMode "configs") (ne $installMode "packages") }}{{- fail "Could not determine installation mode" -}}{{- end -}}
{{- end -}}
{{- /* Interactive package confirmation or the complete three-variable headless     */ -}}
{{- /* update contract advances the trigger. Config-only choices, ordinary apply,    */ -}}
{{- /* and DOTFILES_INSTALL_MODE by itself keep the persisted integer unchanged.     */ -}}
{{- if or (and $wantMode (eq $installMode "packages") (eq (env "DOTFILES_INSTALL_MODE") "") (stdinIsATTY)) $headlessPackageUpdate -}}
{{-   $packageRun = add1 $packageRun -}}
{{- end -}}

# Keep chezmoi's own file and external progress visible during init --apply.
progress = true

[data]
    componentSelection = {{ $sel | quote }}
    gitSelection = {{ get $subSelStore "git" | quote }}
    aiSelection = {{ get $subSelStore "ai" | quote }}
    terminalSelection = {{ get $subSelStore "terminal" | quote }}
    palette = {{ $palette | quote }}
    zshTheme = {{ $zshTheme | quote }}
    installMode = {{ $installMode | quote }}
    packageRun = {{ $packageRun }}

[data.components]
{{ range $components }}{{ if eq (len .sub) 0 }}    {{ .key }} = {{ get $resolved .key }}
{{ end }}{{ end }}
[data.components.git]
{{ range $gitFeatures }}    {{ .key }} = {{ get (get $subResolved "git") .key }}
{{ end }}
[data.components.ai]
{{ range $aiFeatures }}    {{ .key }} = {{ get (get $subResolved "ai") .key }}
{{ end }}
[data.components.terminal]
{{ range $terminalFeatures }}    {{ .key }} = {{ get (get $subResolved "terminal") .key }}
{{ end -}}
