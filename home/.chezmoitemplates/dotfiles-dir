{{- /* home/.chezmoitemplates/dotfiles-dir                                        */ -}}
{{- /* Resolve one user-configurable directory (data.worktreesDir, data.agentsDir) */ -}}
{{- /* to a single clean absolute path. Every consumer calls this through          */ -}}
{{- /* includeTemplate, so the config template, ~/.zshenv, and the directory       */ -}}
{{- /* creation script cannot disagree about what a stored value means.            */ -}}
{{- /*                                                                             */ -}}
{{- /* Input dict:                                                                  */ -}}
{{- /*   home     the target home directory (.chezmoi.homeDir)                      */ -}}
{{- /*   key      the data key, used only in error messages                         */ -}}
{{- /*   value    the raw configured value; empty or unset selects the default      */ -}}
{{- /*   default  leaf name under the home directory used when value is empty       */ -}}
{{- /* A value may be absolute, "~", "~/x", "$HOME", "$HOME/x", or the braced form. */ -}}
{{- /* Anything else fails loudly instead of rendering a relative path into a      */ -}}
{{- /* shell export. The character whitelist keeps the single-quoted exports in    */ -}}
{{- /* ~/.zshenv and the run script safe without per-consumer escaping.            */ -}}
{{- $home := .home -}}
{{- $v := trim .value -}}
{{- if eq $v "" -}}{{- $v = printf "%s/%s" $home .default -}}{{- end -}}
{{- if or (eq $v "~") (eq $v "$HOME") (eq $v "${HOME}") -}}
{{-   $v = $home -}}
{{- else if hasPrefix "~/" $v -}}
{{-   $v = printf "%s/%s" $home (trimPrefix "~/" $v) -}}
{{- else if hasPrefix "$HOME/" $v -}}
{{-   $v = printf "%s/%s" $home (trimPrefix "$HOME/" $v) -}}
{{- else if hasPrefix "${HOME}/" $v -}}
{{-   $v = printf "%s/%s" $home (trimPrefix "${HOME}/" $v) -}}
{{- end -}}
{{- if not (hasPrefix "/" $v) -}}
{{-   fail (printf "data.%s must be an absolute path, ~/..., or $HOME/...; got %q" .key .value) -}}
{{- end -}}
{{- $v = clean $v -}}
{{- if eq $v "/" -}}
{{-   fail (printf "data.%s must not be the filesystem root" .key) -}}
{{- end -}}
{{- if not (regexMatch `^/[A-Za-z0-9._ @%+=:,/~-]+$` $v) -}}
{{-   fail (printf "data.%s must name a directory using only letters, digits, spaces, and . _ @ %% + = : , / ~ -; got %q" .key $v) -}}
{{- end -}}
{{- $v -}}
