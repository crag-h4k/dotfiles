# Re-open the component/palette picker. Changing the selection re-renders the
# run_once installer (new content hash), so newly added components install on the
# same run. An unchanged selection does NOT re-provision - use cup for that.
alias "ccomp"="chezmoi init --apply"
# Update packages through a scoped re-init. The mode prompt increments the
# persisted packageRun only when packages are explicitly selected, so chezmoi
# reruns this installer without deleting any other run_once script state.
alias "cup"="DOTFILES_PACKAGE_UPDATE=1 chezmoi init --apply"
