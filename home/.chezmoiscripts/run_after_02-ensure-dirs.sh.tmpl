#!/usr/bin/env bash
# home/.chezmoiscripts/run_after_02-ensure-dirs.sh.tmpl
# Create the worktrees folder on every apply, and the agent workspace with its
# subdirectories when any AI sub-feature is selected. Both paths come from the
# chezmoi data (worktreesDir, agentsDir) through the shared dotfiles-dir
# template, so they match what ~/.zshenv exports. The helper is idempotent,
# never uses sudo, never moves or deletes anything, and only warns when a parent
# directory is not writable; see scripts/ensure-dirs.sh.
set -euo pipefail

{{/* Same AI sub-feature gate as home/.chezmoiignore and
     run_after_01-finalize-agent-skills.sh.tmpl: the agent workspace exists for
     the shared skills and tools, so it follows the skills. Keep aligned. */ -}}
{{ $agentSkillsEnabled := or
     (dig "components" "ai" "claude_hooks" false .)
     (dig "components" "ai" "codex_hooks" false .)
     (dig "components" "ai" "statusline" false .)
     (dig "components" "ai" "opencode" false .)
     (dig "components" "ai" "copilot" false .)
     (dig "components" "ai" "openviking" false .)
     (dig "components" "ai" "codecompanion" false .) -}}
dirs=({{ includeTemplate "dotfiles-dir" (dict "home" .chezmoi.homeDir "key" "worktreesDir" "value" (dig "worktreesDir" "" .) "default" "worktrees") | squote }})
private_dirs=()
{{- if $agentSkillsEnabled }}
# The agent workspace: plans (and handoffs), specs, drafts, reusable scripts,
# agent-installed tools, throwaway scratch work, and tmp, which the opencode2
# wrapper uses as TMPDIR. tmp is private (700) because temp files can hold
# session data; the rest follow the root's 755.
agents={{ includeTemplate "dotfiles-dir" (dict "home" .chezmoi.homeDir "key" "agentsDir" "value" (dig "agentsDir" "" .) "default" "agents") | squote }}
dirs+=("$agents" "$agents/plans" "$agents/specs" "$agents/drafts" "$agents/scripts" "$agents/tools" "$agents/scratch")
private_dirs+=("$agents/tmp")
{{- end }}

# A failure to create a directory must never fail the apply.
helper="{{ .chezmoi.sourceDir | dir }}/scripts/ensure-dirs.sh"
bash "$helper" "${dirs[@]}" ||
    printf 'dotfiles: WARNING could not check the worktrees and agent directories\n' >&2
if [[ ${#private_dirs[@]} -gt 0 && -d "$agents" && -w "$agents" ]]; then
    bash "$helper" -m 700 "${private_dirs[@]}" ||
        printf 'dotfiles: WARNING could not check the agent temp directory\n' >&2
fi
