# ~/.tmux/conf.d/status.conf
# Generated from .chezmoidata/palettes.yaml. The layout stays custom; only the
# semantic colors change with data.palette.
{{ $p := get .palettes (dig "palette" "dracula" .) -}}

set -g status-interval 2
set -g status on
set -g status-position bottom

# Export shared colors for notify.conf.
set -g @palette_red "{{ $p.colors.red }}"
set -g @palette_black "{{ $p.colors.black }}"
set -g @palette_background "{{ $p.colors.background }}"
set -g @palette_foreground "{{ $p.colors.foreground }}"
set -g @palette_surface "{{ $p.colors.surface }}"
set -g @palette_comment "{{ $p.colors.comment }}"
set -g @palette_green "{{ $p.colors.green }}"

set -g status-bg "{{ $p.colors.background }}"
set -g status-fg "{{ $p.colors.foreground }}"
set -g pane-border-style "fg={{ $p.colors.surface }}"
set -g pane-active-border-style "fg={{ $p.colors.purple }}"
set -g message-style "bg={{ $p.colors.surface }},fg={{ $p.colors.foreground }}"

setw -g window-status-style "fg={{ $p.colors.foreground }},bg={{ $p.colors.background }}"
setw -g window-status-format "#[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}]#[fg={{ $p.colors.comment }},bg={{ $p.colors.surface }}] #I:#[fg={{ $p.colors.foreground }},bg={{ $p.colors.surface }}]#{=18:window_name} #[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}] "
setw -g window-status-current-style "fg={{ $p.colors.foreground }},bg={{ $p.colors.background }}"
setw -g window-status-current-format "#[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}]#[fg={{ $p.colors.green }},bg={{ $p.colors.surface }},bold] #I:#[fg={{ $p.colors.foreground }},bg={{ $p.colors.surface }},bold]#{=18:window_name} #[fg={{ $p.colors.surface }},bg={{ $p.colors.background }},nobold] "

set -g status-left-length 60
set -g status-left "#[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}]#[fg={{ $p.colors.purple }},bg={{ $p.colors.surface }},bold] #{=24:session_name} #[fg={{ $p.colors.foreground }},bg={{ $p.colors.surface }},nobold]#{=18:host} #[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}] "

set -g @cpu_percentage_format "%.0f"
set -g @ram_percentage_format "%.0f"
set -g @tmux-network-bandwidth-padding 4

set -g status-right-length 160
set -g status-right "\
#[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}]#[fg={{ $p.colors.blue }},bg={{ $p.colors.surface }},bold] 󰌗 #[fg={{ $p.colors.foreground }},bg={{ $p.colors.surface }},nobold]#{network_bandwidth} #[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}] \
#[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}]#[fg={{ $p.colors.orange }},bg={{ $p.colors.surface }},bold] ⚙ #[fg={{ $p.colors.foreground }},bg={{ $p.colors.surface }},nobold]#{cpu_percentage}%% #[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}] \
#[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}]#[fg={{ $p.colors.cyan }},bg={{ $p.colors.surface }},bold] ▦ #[fg={{ $p.colors.foreground }},bg={{ $p.colors.surface }},nobold]#{ram_percentage}%% #[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}] \
#[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}]#[fg={{ $p.colors.comment }},bg={{ $p.colors.surface }}] 󰥔 #[fg={{ $p.colors.foreground }},bg={{ $p.colors.surface }}] %Y-%m-%d %H:%M #[fg={{ $p.colors.surface }},bg={{ $p.colors.background }}] "
