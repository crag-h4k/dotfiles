-  if recognizer.supportsOnDeviceRecognition { request.requiresOnDeviceRecognition = true }
+  request.requiresOnDeviceRecognition = true
   recognizer.recognitionTask(with: request, resultHandler: fileResults())
   await runForever()
 }
